{
  "name": "yukki-rui",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "cms": "decap-server",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "check:base": "node scripts/check-base-parity.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:frontend": "node scripts/check-frontend.mjs",
    "check:cms-config": "node scripts/check-cms-config.mjs",
    "check:cms-oauth": "node scripts/check-cms-oauth.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:comments-live": "node scripts/check-comments-live.mjs",
    "check:chat": "node scripts/check-chat.mjs",
    "verify": "npm run check && npm test && npm run check:base && npm run check:content",
    "verify:frontend": "npm run verify && npm run build && npm run check:links && npm run check:og && npm run check:frontend",
    "check:reading": "node scripts/check-reading.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:og": "node scripts/check-og.mjs",
    "check:pages": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@resvg/resvg-js": "^2.6.2",
    "decap-server": "^3.11.4",
    "pagefind": "^1.5.2",
    "satori": "^0.62.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}

---
import PixelSprite from '../../components/PixelSprite.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import StatBar from '../../components/StatBar.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE, RSS_PATH, HERO_IMAGE, type Lang } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags } from '../../lib/posts';
import { getSiteInfo, getHeroImage } from '../../lib/site-info';
import { langHref, withBase } from '../../lib/url';
export function getStaticPaths() { return SITE.langs.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const posts = await getPosts(lang);
const tags = await getTags(lang);
const zh = lang === 'zh';
// 个人资料来自 site 集合（可在 /admin 后台编辑）；字段留空时回落到这里的默认文案。
const info = await getSiteInfo(lang);
const text = zh ? {
  hello: '欢迎来到我的存档点', intro: '写代码，也写文字。', sub: '把日常的灵感存进像素世界，让每一段文字都有自己的小宇宙。',
  read: '开始阅读', about: '认识站长', works: '作品存档', contact: '保持联络', latest: '最新日志',
  diary: '双语个人博客', diaryText: '你正在访问的这个小站：Astro 静态生成、Markdown 写作，支持中英切换与深浅主题。',
  slot: '下一份作品', slotText: '留给下一个值得记录的想法。真实作品与项目地址待补充。',
  rss: '订阅更新', rssText: '用 RSS 收藏这个存档点。下一篇文章发布后，在你的阅读器里见。',
  social: '个人联系方式', socialText: '邮箱与社交账号待补充。在此之前，可以先读读关于页面。',
  note: '喜欢镜音双子，喜欢像素，也喜欢把想法写下来。',
} : {
  hello: 'WELCOME TO MY SAVE POINT', intro: 'A little code. A little story.', sub: 'Saving everyday inspiration in a pixel world, one small universe at a time.',
  read: 'Start reading', about: 'Meet the author', works: 'Work archive', contact: 'Stay connected', latest: 'Latest logs',
  diary: 'Bilingual personal blog', diaryText: 'The site you are exploring: built with Astro and Markdown, with two languages and two color themes.',
  slot: 'The next creation', slotText: 'A slot reserved for the next idea worth sharing. Real work and project links are yet to be added.',
  rss: 'Follow the updates', rssText: 'Save this checkpoint in your RSS reader. See you there when the next story arrives.',
  social: 'Personal contact', socialText: 'Email and social profiles are yet to be added. For now, visit the about page.',
  note: 'Kagamine Twins, pixels, and a place to write things down.',
};
const hero = { intro: info?.hero.intro || text.intro, sub: info?.hero.sub || text.sub, note: info?.hero.note || text.note };
// 形象照：本语言优先，其次另一语言（传一次两边都显示），最后回落到 HERO_IMAGE。
const heroImage = await getHeroImage(lang);
const contact = { text: info?.contact.text || text.socialText, links: info?.contact.links ?? [] };
const work = {
  title: info?.work.title || text.slot,
  text: info?.work.text || text.slotText,
  linkLabel: info?.work.linkLabel ?? '',
  linkUrl: info?.work.linkUrl ?? '',
  status: info?.work.status ?? 'WIP',
};
const decor = [
  { name: 'star-gold', x: 6, y: 20, size: 26 }, { name: 'note-blue', x: 89, y: 22, size: 36 },
  { name: 'star-pink', x: 80, y: 63, size: 22 }, { name: 'note-orange', x: 12, y: 67, size: 30 },
  { name: 'star-blue', x: 42, y: 14, size: 18 }, { name: 'coin-sprite', x: 66, y: 79, size: 22 },
];
---
<BaseLayout title={SITE.title} description={SITE.description} lang={lang} alternate={langHref(zh ? 'en' : 'zh')}>
  <div class="world-status"><span><i></i> YUKKI'S WORLD</span><span>LOG / {String(posts.length).padStart(2, '0')} <b>✦</b> {zh ? '欢迎访问' : 'WELCOME'}</span></div>
  <section class="hero pixel-world" aria-labelledby="welcome">
    <div class="world-hud"><span>WORLD 01 · HOME</span><span aria-label={zh ? '装饰生命值' : 'Decorative life meter'}>♥ ♥ ♥ <small>FULL OF IDEAS</small></span></div>
    <div class="pixel-cloud cloud-a" aria-hidden="true"></div><div class="pixel-cloud cloud-b" aria-hidden="true"></div>
    {decor.map((d, i) => <span class="hero-sprite" aria-hidden="true" style={`left:${d.x}%;top:${d.y}%;--float-delay:${i * -.7}s`}><PixelSprite name={d.name} size={d.size} /></span>)}
    <div class="hero-copy rise">
      <p class="eyebrow">✦ {text.hello} ✦</p>
      <h1 id="welcome">yukki <span>rui</span><em>_</em></h1>
      <p class="hero-lead">{hero.intro}</p>
      <p class="hero-description">{hero.sub}</p>
      <div class="hero-actions"><a class="pixel-button primary" href="#latest"><span aria-hidden="true">▶</span> {text.read}</a><a class="pixel-button" href={withBase(`${lang}/about/`)}>{text.about} ↗</a></div>
      <div class="hero-badges"><span>01 · CODE</span><span>02 · WORDS</span><span>03 · KAGAMINE</span></div>
    </div>
    <div class="character-stage">
      <span class="speech-bubble">HELLO, WORLD! <span>♪</span></span>
      {heroImage.src ? (
        <img class="hero-image" src={withBase(heroImage.src)} alt={zh ? HERO_IMAGE.altZh : HERO_IMAGE.altEn} width={heroImage.width} height={heroImage.height} loading="eager" decoding="async" />
      ) : (
        <div class="hero-image-slot" role="img" aria-label={zh ? '形象照片待补充' : 'Portrait placeholder'}>
          <PixelSprite name="star-gold" size={36} />
          <span class="pixel-caption">{zh ? '在后台「个人资料」里上传照片' : 'Upload a photo in the site admin'}</span>
        </div>
      )}
      <div class="stage-platform" aria-hidden="true"></div>
    </div>
    <div class="scene-grass" aria-hidden="true"><span>✿</span><span>♧</span><span>✿</span></div>
    <div class="scene-ground" aria-hidden="true"></div>
  </section>
  <div class="world-ticker"><span>✦ SAVE YOUR IDEAS</span><span>♪ KEEP CREATING</span><span>✦ LITTLE THINGS MATTER</span></div>
  <div class="stat-row"><StatBar icon="coin-sprite" label={zh ? '文章' : 'LOGS'} value={String(posts.length).padStart(2, '0')} /><StatBar icon="star-blue" label={zh ? '标签' : 'TAGS'} value={String(tags.length).padStart(2, '0')} tone="len" /><StatBar icon="note-orange" label={zh ? '语言' : 'LANG'} value="ZH / EN" /></div>
  <section aria-labelledby="work-heading"><SectionTitle title={text.works} icon="coin-sprite" tail="QUEST 01" /><div class="grid-2">
    <article class="card project-card"><div class="project-art art-blog" aria-hidden="true"><div class="mini-window"><div>● ● ● <span>BLOG.MD</span></div><p>&gt; hello, world_</p><i></i><i></i><i></i></div><PixelSprite name="star-gold" size={32} /></div><div class="project-head"><span class="quest-number">01</span><h3 id="work-heading">{text.diary}</h3><span class="status-badge">LIVE</span></div><p>{text.diaryText}</p><div class="project-foot"><span class="tech-chip">ASTRO</span><span class="tech-chip">MARKDOWN</span><a href={withBase(`${lang}/about/`)}>{zh ? '小站介绍' : 'About the site'} ↗</a></div></article>
    <article class="card project-card"><div class="project-art art-next" aria-hidden="true"><div class="locked-slot">? <PixelSprite name="key" size={36} /></div><span class="pixel-caption">A NEW ADVENTURE AWAITS</span></div><div class="project-head"><span class="quest-number">02</span><h3>{work.title}</h3><span class={`status-badge${work.status === 'WIP' ? ' muted' : ''}`}>{work.status}</span></div><p>{work.text}</p><div class="project-foot">{work.linkUrl ? <a href={work.linkUrl}>{work.linkLabel || work.linkUrl} ↗</a> : work.status === 'WIP' ? <span class="tech-chip">COMING LATER</span> : null}<PixelSprite name="star-blue" size={20} /></div></article>
  </div></section>
  <section><SectionTitle title={text.contact} icon="note-blue" tail="QUEST 02" /><div class="grid-2"><div class="card contact-card"><span class="contact-symbol" aria-hidden="true">(( • ))</span><div><h3>{text.rss}</h3><p>{text.rssText}</p><a class="text-link" href={withBase(RSS_PATH[lang])}>RSS {zh ? '订阅' : 'FEED'} ↗</a></div></div><div class="card contact-card"><span class="contact-symbol" aria-hidden="true">[ @ ]</span><div><h3>{text.social}</h3><p class="contact-text">{contact.text}</p>{contact.links.length ? <div class="social-links">{contact.links.map((link) => <a class="text-link" href={link.url}>{link.label} ↗</a>)}</div> : <a class="text-link" href={withBase(`${lang}/about/`)}>{text.about} ↗</a>}</div></div></div></section>
  <section id="latest"><SectionTitle title={text.latest} icon="star-gold" tail="QUEST 03" /><div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div></section>
  <div class="end-note"><PixelSprite name="note-orange" size={22} /><p>{hero.note}</p><PixelSprite name="note-blue" size={22} /></div>
</BaseLayout>

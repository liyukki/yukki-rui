---
import { getCollection, render } from 'astro:content';
import { SITE } from '../../../consts';
import PostLayout from '../../../layouts/PostLayout.astro';
import {
  resolveJourneys,
  selectJourneysForPost,
  selectPublishedJourneys,
  type JourneyInput,
} from '../../../lib/journeys';
import { getPosts, getPostsByDate, getTranslations, type Post } from '../../../lib/posts';
import { selectRelatedPosts } from '../../../lib/related';
import { postHref } from '../../../lib/url';

export async function getStaticPaths() {
  const byLanguage = await Promise.all(SITE.langs.map(async (lang) =>
    (await getPosts(lang)).map((post) => ({ params: { lang, id: post.id }, props: { post } })),
  ));
  return byLanguage.flat();
}

interface Props { post: Post }
const { post } = Astro.props;
const translation = await getTranslations(post);
const { Content, headings } = await render(post);

/** 同语言文章按发布日期倒序：index-1 是更新的，index+1 是更早的。 */
const siblings = await getPostsByDate(post.data.lang);
const index = siblings.findIndex((entry) => entry.id === post.id);
const newer = index > 0 ? siblings[index - 1] : undefined;
const older = index >= 0 ? siblings[index + 1] : undefined;
const related = selectRelatedPosts(post, siblings);
const journeyEntries = (await getCollection('journeys'))
  .filter((entry) => entry.data.lang === post.data.lang)
  .map((entry) => entry.data as JourneyInput);
const journeys = selectPublishedJourneys(
  resolveJourneys(
    journeyEntries,
    siblings.map((entry) => ({
      id: entry.id,
      lang: post.data.lang,
      title: entry.data.title,
      href: postHref(post.data.lang, entry.id),
    })),
  ),
  post.data.lang,
);
const postJourneys = selectJourneysForPost(journeys, post.id);
---
<PostLayout
  post={post}
  translations={translation}
  headings={headings}
  prev={older}
  next={newer}
  related={related}
  journeys={postJourneys}
  postId={post.id}
>
  <Content />
</PostLayout>

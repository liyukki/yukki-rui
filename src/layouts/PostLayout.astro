---
/**
 * 文章页布局：标题、日期、阅读时长、标签、目录、正文 slot、上一篇/下一篇与（可选）评论。
 * 语言切换只在确有真实译文时指向译文页，否则 Header 回目标语言首页。
 */
import Comments from '../components/Comments.astro';
import PostExtras from '../components/PostExtras.astro';
import PostLikes from '../components/PostLikes.astro';
import PostNav from '../components/PostNav.astro';
import PostShare from '../components/PostShare.astro';
import PostToc from '../components/PostToc.astro';
import ReadingSettings from '../components/ReadingSettings.astro';
import TagList from '../components/TagList.astro';
import { SITE, UI } from '../consts';
import { postLikeKey } from '../lib/post-likes';
import type { Post } from '../lib/posts';
import { ogImagePath } from '../lib/og';
import {
  countReadingMinutes,
  formatReadingTime,
  selectTocHeadings,
  type ReadingHeading,
} from '../lib/reading';
import { absoluteHref, postHref, withBase } from '../lib/url';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
  translations?: Post;
  /** Astro `render()` 返回的标题列表；缺省时不渲染目录。 */
  headings?: ReadingHeading[];
  /** 更新的一篇（上一篇）；缺省不渲染对应卡片。 */
  prev?: Post;
  /** 更早的一篇（下一篇）。 */
  next?: Post;
  /** 与当前文章共享标签的推荐；缺省时不渲染区块。 */
  related?: Post[];
}
const { post, translations, headings, prev, next, related = [] } = Astro.props;
const lang = post.data.lang;
const alternate = translations
  ? postHref(translations.data.lang, translations.id)
  : undefined;
const dateFmt = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en', { dateStyle: 'long' });
const tocHeadings = selectTocHeadings(headings ?? []);
const readingTime = formatReadingTime(countReadingMinutes(post.body ?? ''), UI[lang].readingTime);

/** 把文章条目转成上下篇卡片需要的形状；日期在布局层统一格式化。 */
function toNav(entry: Post | undefined) {
  if (!entry) return null;
  return {
    href: postHref(entry.data.lang, entry.id),
    title: entry.data.title,
    date: dateFmt.format(entry.data.pubDate),
  };
}

/** 每篇文章的分享图由 src/pages/og/[...slug].png.ts 在构建期生成。 */
const shareImage = ogImagePath(post.id);
const canonical = absoluteHref(Astro.url.pathname);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  keywords: post.data.tags.join(','),
  mainEntityOfPage: canonical,
  image: absoluteHref(withBase(shareImage)),
  url: canonical,
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.name },
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  ogType="article"
  ogImage={shareImage}
  jsonLd={jsonLd}
  alternate={alternate}
  aiArticleId={post.id}
>
  <article class="prose rise post" data-pagefind-body>
    <PostExtras
      lang={lang}
      copyLabel={UI[lang].copyCode}
      copiedLabel={UI[lang].copiedCode}
      copyFailedLabel={UI[lang].copyFailed}
      backToTopLabel={UI[lang].backToTop}
      closeLabel={UI[lang].closeLightbox}
    />
    <header>
      <h1>{post.data.title}</h1>
      <p class="post-meta" data-pagefind-ignore>
        <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
        {post.data.updatedDate && (
          <>
            {' · '}{UI[lang].updatedAt}{' '}
            <time datetime={post.data.updatedDate.toISOString()}>{dateFmt.format(post.data.updatedDate)}</time>
          </>
        )}
        {' · '}<span class="post-reading">{readingTime}</span>
      </p>
      <TagList lang={lang} tags={post.data.tags} />
    </header>
    <PostToc headings={tocHeadings} lang={lang} variant="inline" label={UI[lang].toc} />
    <ReadingSettings t={UI[lang]} />
    <div class="post-layout">
      <div class="post-body">
        <slot />
      </div>
      <PostToc headings={tocHeadings} lang={lang} variant="aside" label={UI[lang].toc} />
    </div>
    {related.length > 0 && (
      <section class="post-related" data-pagefind-ignore aria-labelledby="related-title">
        <h2 id="related-title">{UI[lang].relatedPosts}</h2>
        <ul>
          {related.map((item) => (
            <li>
              <a href={postHref(item.data.lang, item.id)}>{item.data.title}</a>
              <p>{item.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <PostNav
      prev={toNav(prev)}
      next={toNav(next)}
      prevLabel={UI[lang].prevPost}
      nextLabel={UI[lang].nextPost}
    />
    <PostLikes lang={lang} postKey={postLikeKey(post)}>
      <PostShare
        lang={lang}
        title={post.data.title}
        text={post.data.description}
        url={canonical}
      />
    </PostLikes>
    <Comments lang={lang} />
  </article>
</BaseLayout>

<style>
  /* 文章容器比默认正文宽，给右侧 sticky 目录留位置。 */
  .post {
    max-width: var(--maxw-wide);
  }

  .post-layout {
    display: grid;
    gap: var(--space-5);
  }

  .post-reading {
    color: var(--text-dim);
  }

  /* 相关文章推荐沿用卡片样式，只在至少有同标签文章时渲染。 */
  .post-related {
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow);
  }

  .post-related h2 {
    margin: 0 0 var(--space-3);
  }

  .post-related ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-related li {
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }

  .post-related a {
    color: var(--link);
    font-weight: 700;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }

  .post-related p {
    margin: var(--space-2) 0 0;
    color: var(--text-dim);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  /* 目录组件在子组件里，需要 :global 才能从父组件命中。 */
  @media (min-width: 1024px) {
    .post-layout {
      grid-template-columns: minmax(0, var(--reading-width)) 200px;
      justify-content: center;
      align-items: start;
    }

    :global(.post-toc--inline) {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    :global(.post-toc--aside) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .post-related ul {
      grid-template-columns: 1fr;
    }
  }
</style>

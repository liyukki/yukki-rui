---
/** 页面骨架：引入全局 CSS，集中 BaseHead 与主题初始化脚本。 */
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/world.css';
import AiChat from '../components/AiChat.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import NoteRain from '../components/NoteRain.astro';
import type { Lang } from '../consts';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** 结构化数据；缺省不输出 JSON-LD */
  jsonLd?: Record<string, unknown>;
  /** 另一语言对应页（已含 base）；同时传给 BaseHead 的 hreflang 与 Header 的语言按钮 */
  alternate?: string;
  /** 当前文章 id；仅文章页传入，供聊天窗优先检索本文。 */
  aiArticleId?: string;
}
const { title, description, lang, ogType, ogImage, jsonLd, alternate, aiArticleId } = Astro.props;
---
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <BaseHead title={title} description={description} lang={lang} ogType={ogType} ogImage={ogImage} alternate={alternate} />
    {jsonLd && <JsonLd data={jsonLd} />}
    <ClientRouter />
    <script is:inline>
      (() => {
        const applyTheme = () => {
          let saved;
          try { saved = localStorage.getItem('theme'); } catch {}
          document.documentElement.dataset.theme = saved === 'light' || saved === 'dark'
            ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        };
        applyTheme();
        // View Transitions 会替换 <html> 的属性，转场后必须重新贴上主题，否则会闪回默认主题。
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <script is:inline>
      (() => {
        // 阅读设置先在 <head> 内联恢复，避免首屏按默认字号闪一下再跳变。
        const applyReading = () => {
          let saved;
          try { saved = JSON.parse(localStorage.getItem('reading-settings') || 'null') || {}; } catch { saved = {}; }
          const pick = (value, allowed, fallback) => (allowed.includes(value) ? value : fallback);
          const root = document.documentElement;
          root.dataset.readingSize = pick(saved.size, ['sm', 'md', 'lg'], 'md');
          root.dataset.readingLine = pick(saved.line, ['tight', 'normal', 'loose'], 'normal');
          root.dataset.readingWidth = pick(saved.width, ['narrow', 'normal', 'wide'], 'normal');
        };
        applyReading();
        // View Transitions 会替换 <html> 的属性，转场后必须重新贴上阅读设置，否则会闪回默认字号。
        document.addEventListener('astro:after-swap', applyReading);
      })();
    </script>
  </head>
  <body>
    <div class="bg-orbs" aria-hidden="true"></div>
    <NoteRain />
    <div class="scanlines" aria-hidden="true"></div>
    <Header lang={lang} alternateUrl={alternate} />
    <main class="wrap">
      <slot />
    </main>
    <Footer lang={lang} />
    <div data-ai-page-context data-lang={lang} data-article-id={aiArticleId ?? ''} hidden></div>
    <AiChat lang={lang} articleId={aiArticleId} />
  </body>
</html>

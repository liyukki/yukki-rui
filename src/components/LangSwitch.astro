---
/** 语言切换：只跳转到真实存在的对应页；缺少译文时显示不可用状态。 */
import { UI, type Lang } from '../consts';
import { resolveLanguageSwitch } from '../lib/language-switch';

interface Props {
  lang: Lang;
  /** 语言按钮目标（已含 base）；缺失时不生成链接。 */
  languageSwitchUrl?: string;
}
const { lang, languageSwitchUrl } = Astro.props;
const target = resolveLanguageSwitch(lang, languageSwitchUrl);
const hrefLang = target.lang === 'en' ? 'en' : 'zh-CN';
---
{target.href ? (
  <a
    class="icon-btn"
    href={target.href}
    hreflang={hrefLang}
    aria-label={UI[lang].languageSwitch}
    data-lang-target={target.lang}
  >
    {UI[lang].languageSwitch}
  </a>
) : (
  <span
    class="icon-btn lang-switch--disabled"
    aria-disabled="true"
    aria-label={UI[lang].languageUnavailable}
    title={UI[lang].languageUnavailable}
    data-language-unavailable
  >
    {UI[lang].languageSwitch}
  </span>
)}
<script is:inline>
  (() => {
    const init = () => {
      const link = document.querySelector('a[data-lang-target]');
      if (!link || link.dataset.bound === '1') return;
      link.dataset.bound = '1';
      link.addEventListener('click', () => {
        try { localStorage.setItem('lang', link.dataset.langTarget); } catch {}
      });
    };
    init();
    // 页面转场后链接是新的 DOM 节点，需要重新绑定。
    document.addEventListener('astro:page-load', init);
  })();
</script>
<style>
  .lang-switch--disabled {
    cursor: not-allowed;
    opacity: 0.68;
    box-shadow: none;
  }

  .lang-switch--disabled:hover {
    transform: none;
    border-color: var(--line);
    box-shadow: none;
  }
</style>

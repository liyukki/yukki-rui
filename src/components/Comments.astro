---
/**
 * 评论区：免登录，浏览器直接调 Cloudflare Pages Functions（/api/comments）。
 *
 * - Cloudflare 部署：同源，走相对路径 /api/comments；
 * - GitHub Pages 镜像：没有 Functions，跨域调主站（服务端 CORS 白名单）；
 * - COMMENTS.enabled === false 时不输出任何 DOM，也不加载脚本逻辑。
 *
 * 数据全在客户端渲染，正文一律用 textContent，不拼 HTML。
 */
import { COMMENTS, SITE, UI, type Lang } from '../consts';
import { commentThread, commentsEndpoint } from '../lib/comments';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
// 这些文案键由主代理统一补进 src/consts.ts；在补齐前用本地兜底，保证组件可独立构建。
const rawT = t as unknown as Record<string, string | undefined>;
const extraFallback =
  lang === 'en'
    ? {
        reply: 'Reply',
        replyTo: 'Reply to',
        reactionLike: 'Like',
        reactionLove: 'Love',
        reactionUseful: 'Useful',
        replyPosted: 'Reply posted.',
      }
    : {
        reply: '回复',
        replyTo: '回复',
        reactionLike: '赞',
        reactionLove: '喜欢',
        reactionUseful: '有用',
        replyPosted: '回复成功。',
      };
const thread = commentThread(Astro.url.pathname, import.meta.env.BASE_URL);
const endpoint = commentsEndpoint(SITE.url, COMMENTS.origin);
const i18n = {
  empty: t.commentsEmpty,
  loading: t.commentsLoading,
  loadError: t.commentsLoadError,
  retry: t.commentsRetry,
  loadMore: t.commentsLoadMore,
  submit: t.commentsSubmit,
  submitting: t.commentsSubmitting,
  posted: t.commentsPosted,
  errorInvalid: t.commentsErrorInvalid,
  errorQuick: t.commentsErrorQuick,
  errorRate: t.commentsErrorRate,
  errorUnavailable: t.commentsErrorUnavailable,
  errorFailed: t.commentsErrorFailed,
  name: t.commentsName,
  website: t.commentsWebsite,
  body: t.commentsBody,
  bodyPlaceholder: t.commentsBodyPlaceholder,
  reply: rawT.commentsReply ?? extraFallback.reply,
  replyTo: rawT.commentsReplyTo ?? extraFallback.replyTo,
  reactionLike: rawT.commentsReactionLike ?? extraFallback.reactionLike,
  reactionLove: rawT.commentsReactionLove ?? extraFallback.reactionLove,
  reactionUseful: rawT.commentsReactionUseful ?? extraFallback.reactionUseful,
  replyPosted: rawT.commentsReplyPosted ?? extraFallback.replyPosted,
};
---

{COMMENTS.enabled && (
  <section
    class="comments"
    id="comments"
    aria-label={t.comments}
    data-pagefind-ignore
    data-thread={thread}
    data-api={endpoint}
    data-lang={lang}
    data-page-size={String(COMMENTS.pageSize)}
    data-i18n={JSON.stringify(i18n)}
  >
    <header class="comments-head">
      <h2>{t.comments}<span class="comments-count" data-comments-count></span></h2>
    </header>
    <p class="comments-hint">{t.commentsHint}</p>
    <p class="comments-status" data-comments-status role="status" aria-live="polite"></p>
    <ul class="comments-list" data-comments-list></ul>
    <button type="button" class="comments-more" data-load-more hidden>{t.commentsLoadMore}</button>

    <form class="comment-form" data-comment-form novalidate>
      <div class="comment-fields">
        <label>
          <span>{t.commentsName}</span>
          <input
            type="text"
            name="author"
            maxlength="40"
            required
            autocomplete="nickname"
            placeholder={t.commentsNamePlaceholder}
          />
        </label>
        <label>
          <span>{t.commentsWebsite}</span>
          <input
            type="url"
            name="website"
            maxlength="200"
            autocomplete="url"
            placeholder={t.commentsWebsitePlaceholder}
          />
        </label>
      </div>
      <label class="comment-body-field">
        <span>{t.commentsBody}</span>
        <textarea name="body" rows="4" maxlength="2000" required placeholder={t.commentsBodyPlaceholder}></textarea>
      </label>
      <div class="comment-trap" aria-hidden="true">
        <label>Website<input type="text" name="trap" tabindex="-1" autocomplete="off" /></label>
      </div>
      <div class="comment-actions">
        <button type="submit" class="btn-primary" data-submit>{t.commentsSubmit}</button>
        <p class="comments-status" data-form-status role="status" aria-live="polite"></p>
      </div>
    </form>
  </section>
)}

<script>
  import { commentsApiUrl, formatCommentTime, reactionsEndpoint } from '../lib/comments';

  type Lang = 'zh' | 'en';
  type ReactionType = 'like' | 'love' | 'useful';

  interface CommentItem {
    id: number;
    parentId: number | null;
    author: string;
    body: string;
    website: string;
    createdAt: string;
    replies?: CommentItem[];
    replyCount?: number;
  }

  interface ListResponse {
    items: CommentItem[];
    total: number;
    nextBefore: number | null;
  }

  interface PostResponse {
    item?: CommentItem;
    error?: string;
  }

  interface ReactionState {
    counts: Record<string, number>;
    mine: Set<string>;
  }

  interface ReactionsGetResponse {
    counts?: Record<string, Record<string, number>>;
    mine?: Record<string, string[]>;
  }

  interface ReactionsPostResponse {
    counts?: Record<string, number>;
    mine?: string[];
    error?: string;
  }

  const REACTION_TYPES: ReactionType[] = ['like', 'love', 'useful'];
  const NICKNAME_KEY = 'comments-author';

  function emptyReactionCounts(): Record<string, number> {
    return Object.fromEntries(REACTION_TYPES.map((reaction) => [reaction, 0]));
  }

  /**
   * 初始化评论区。可重复调用：View Transitions 换页后重新按当前 DOM 绑定。
   */
  function initComments(): void {
    const root = document.getElementById('comments');
    if (!root || root.dataset.ready === '1') return;
    root.dataset.ready = '1';

    const lang: Lang = root.dataset.lang === 'en' ? 'en' : 'zh';
    const i18n = JSON.parse(root.dataset.i18n ?? '{}') as Record<string, string>;
    const api = commentsApiUrl(window.location.origin, root.dataset.api ?? '');
    const reactionsApi = reactionsEndpoint(api);
    const thread = root.dataset.thread ?? '/';
    const pageSize = Number(root.dataset.pageSize) || 20;
    const startedAt = Date.now();

    const list = root.querySelector<HTMLUListElement>('[data-comments-list]');
    const count = root.querySelector<HTMLElement>('[data-comments-count]');
    const status = root.querySelector<HTMLElement>('[data-comments-status]');
    const more = root.querySelector<HTMLButtonElement>('[data-load-more]');
    const form = root.querySelector<HTMLFormElement>('[data-comment-form]');
    const formStatus = root.querySelector<HTMLElement>('[data-form-status]');
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]');
    const nameInput = form?.querySelector<HTMLInputElement>('input[name="author"]');
    const bodyInput = form?.querySelector<HTMLTextAreaElement>('textarea[name="body"]');

    const replyLabel = i18n.reply ?? 'Reply';
    const reactionLabels: Record<ReactionType, string> = {
      like: i18n.reactionLike ?? 'Like',
      love: i18n.reactionLove ?? 'Love',
      useful: i18n.reactionUseful ?? 'Useful',
    };

    let nextBefore: number | null = null;
    let total = 0;
    let childCount = 0;
    let loading = false;
    let posting = false;
    let openReply: { rootId: number; slot: HTMLElement; form: HTMLFormElement } | null = null;

    const reactionState = new Map<number, ReactionState>();

    const setStatus = (text: string) => {
      if (status) status.textContent = text;
    };
    const setFormStatus = (text: string) => {
      if (formStatus) formStatus.textContent = text;
    };
    const updateCount = () => {
      if (count) count.textContent = total > 0 ? `(${total})` : '';
    };
    const removeRetry = () => {
      root.querySelectorAll('.comment-retry').forEach((node) => node.remove());
    };
    const firstChar = (author: string) => [...author.trim()][0] ?? '?';

    function ensureReactionState(commentId: number): ReactionState {
      let state = reactionState.get(commentId);
      if (!state) {
        state = { counts: emptyReactionCounts(), mine: new Set<string>() };
        reactionState.set(commentId, state);
      }
      return state;
    }

    function applyReactionState(commentId: number): void {
      const state = ensureReactionState(commentId);
      root!
        .querySelectorAll<HTMLButtonElement>(`.comment-reaction[data-comment-id="${commentId}"]`)
        .forEach((button) => {
          const reaction = button.dataset.reaction as ReactionType | undefined;
          if (!reaction) return;
          const active = state.mine.has(reaction);
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('is-active', active);
          const countEl = button.querySelector<HTMLElement>('.reaction-count');
          if (countEl) countEl.textContent = String(state.counts[reaction] ?? 0);
        });
    }

    async function toggleReaction(commentId: number, reaction: ReactionType): Promise<void> {
      const state = ensureReactionState(commentId);
      const active = !state.mine.has(reaction);
      const buttons = root!.querySelectorAll<HTMLButtonElement>(
        `.comment-reaction[data-comment-id="${commentId}"]`,
      );
      buttons.forEach((button) => {
        button.disabled = true;
      });
      try {
        const response = await fetch(new URL(reactionsApi, window.location.origin), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ commentId, reaction, active }),
        });
        const result = (await response.json().catch(() => ({}))) as ReactionsPostResponse;
        if (response.ok && result.counts) {
          reactionState.set(commentId, {
            counts: { ...emptyReactionCounts(), ...result.counts },
            mine: new Set(result.mine ?? []),
          });
          applyReactionState(commentId);
        } else {
          setStatus(messageFor(response.status, result.error));
        }
      } catch {
        setStatus(i18n.errorFailed ?? '');
      } finally {
        buttons.forEach((button) => {
          button.disabled = false;
        });
      }
    }

    async function loadReactionsFor(items: CommentItem[]): Promise<void> {
      const ids = [...new Set(items.flatMap((item) => [item.id, ...(item.replies ?? []).map((reply) => reply.id)]))];
      for (let offset = 0; offset < ids.length; offset += 50) {
        const chunk = ids.slice(offset, offset + 50);
        try {
          const url = new URL(reactionsApi, window.location.origin);
          url.searchParams.set('ids', chunk.join(','));
          const response = await fetch(url, { headers: { Accept: 'application/json' } });
          if (!response.ok) continue;
          const data = (await response.json()) as ReactionsGetResponse;
          for (const id of chunk) {
            reactionState.set(id, {
              counts: { ...emptyReactionCounts(), ...(data.counts?.[String(id)] ?? {}) },
              mine: new Set(data.mine?.[String(id)] ?? []),
            });
            applyReactionState(id);
          }
        } catch {
          /* 反应读取失败不阻塞评论主体显示，按钮仍可点击重试。 */
        }
      }
    }

    function renderReactions(item: CommentItem): HTMLDivElement {
      const group = document.createElement('div');
      group.className = 'comment-reactions';
      const state = ensureReactionState(item.id);
      for (const reaction of REACTION_TYPES) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'comment-reaction';
        button.dataset.commentId = String(item.id);
        button.dataset.reaction = reaction;
        button.title = reactionLabels[reaction];
        button.setAttribute('aria-pressed', String(state.mine.has(reaction)));

        const label = document.createElement('span');
        label.className = 'reaction-label';
        label.textContent = reactionLabels[reaction];
        const countEl = document.createElement('span');
        countEl.className = 'reaction-count';
        countEl.textContent = String(state.counts[reaction] ?? 0);
        button.append(label, countEl);
        button.addEventListener('click', () => void toggleReaction(item.id, reaction));
        group.append(button);
      }
      return group;
    }

    function updateReplyButton(rootId: number, replyCount: number): void {
      const button = list?.querySelector<HTMLButtonElement>(
        `.comment[data-reply="0"][data-comment-id="${rootId}"] .comment-reply-button`,
      );
      if (button) button.textContent = `${replyLabel}${replyCount > 0 ? ` (${replyCount})` : ''}`;
    }

    function closeReplyForm(): void {
      if (!openReply) return;
      openReply.slot.replaceChildren();
      openReply = null;
    }

    function createField(labelText: string, control: HTMLInputElement | HTMLTextAreaElement): HTMLLabelElement {
      const label = document.createElement('label');
      const span = document.createElement('span');
      span.textContent = labelText;
      label.append(span, control);
      return label;
    }

    function createReplyForm(rootItem: CommentItem, rootLi: HTMLLIElement): HTMLFormElement {
      const replyForm = document.createElement('form');
      replyForm.className = 'comment-reply-form';
      replyForm.noValidate = true;

      const heading = document.createElement('p');
      heading.className = 'comment-reply-heading';
      heading.textContent = `${i18n.replyTo ?? 'Reply to'} ${rootItem.author}`;

      const author = document.createElement('input');
      author.type = 'text';
      author.name = 'author';
      author.maxLength = 40;
      author.required = true;
      author.setAttribute('autocomplete', 'nickname');
      author.value = nameInput?.value || '';
      const website = document.createElement('input');
      website.type = 'url';
      website.name = 'website';
      website.maxLength = 200;
      website.setAttribute('autocomplete', 'url');
      const body = document.createElement('textarea');
      body.name = 'body';
      body.rows = 3;
      body.maxLength = 2000;
      body.required = true;
      body.placeholder = i18n.bodyPlaceholder ?? '';

      const fields = document.createElement('div');
      fields.className = 'comment-fields';
      fields.append(
        createField(i18n.name ?? '', author),
        createField(i18n.website ?? '', website),
      );

      const bodyField = createField(i18n.body ?? '', body);
      bodyField.className = 'comment-body-field';

      const trap = document.createElement('div');
      trap.className = 'comment-trap';
      trap.setAttribute('aria-hidden', 'true');
      const trapLabel = document.createElement('label');
      trapLabel.textContent = 'Website';
      const trapInput = document.createElement('input');
      trapInput.type = 'text';
      trapInput.name = 'trap';
      trapInput.tabIndex = -1;
      trapInput.setAttribute('autocomplete', 'off');
      trapLabel.append(trapInput);
      trap.append(trapLabel);

      const actions = document.createElement('div');
      actions.className = 'comment-actions';
      const submitButton = document.createElement('button');
      submitButton.type = 'submit';
      submitButton.className = 'btn-primary';
      submitButton.textContent = i18n.submit ?? 'Post';
      const replyStatus = document.createElement('p');
      replyStatus.className = 'comments-status';
      replyStatus.setAttribute('role', 'status');
      replyStatus.setAttribute('aria-live', 'polite');
      actions.append(submitButton, replyStatus);

      const formStartedAt = Date.now();
      let replyPosting = false;

      replyForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (replyPosting) return;
        const data = new FormData(replyForm);
        const payload = {
          thread,
          author: String(data.get('author') ?? ''),
          body: String(data.get('body') ?? ''),
          website: String(data.get('website') ?? ''),
          trap: String(data.get('trap') ?? ''),
          elapsed: Date.now() - formStartedAt,
          parentId: rootItem.id,
        };

        replyPosting = true;
        submitButton.disabled = true;
        const originalLabel = submitButton.textContent ?? '';
        submitButton.textContent = i18n.submitting ?? '';
        replyStatus.textContent = '';

        try {
          const response = await fetch(new URL(api, window.location.origin), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = (await response.json().catch(() => ({}))) as PostResponse;
          if (response.status === 201 && result.item) {
            const replies = rootLi.querySelector<HTMLUListElement>('.comment-replies');
            if (replies) {
              replies.append(renderItem({ ...result.item, replies: [], replyCount: 0 }, { isReply: true }));
              updateReplyButton(rootItem.id, replies.querySelectorAll(':scope > .comment').length);
              void loadReactionsFor([result.item]);
            }
            body.value = '';
            replyStatus.textContent = i18n.replyPosted ?? '';
          } else {
            replyStatus.textContent = messageFor(response.status, result.error);
          }
        } catch {
          replyStatus.textContent = i18n.errorFailed ?? '';
        } finally {
          replyPosting = false;
          submitButton.disabled = false;
          submitButton.textContent = originalLabel;
        }
      });

      replyForm.append(heading, fields, bodyField, trap, actions);
      return replyForm;
    }

    function openReplyForm(rootItem: CommentItem, rootLi: HTMLLIElement): void {
      const slot = rootLi.querySelector<HTMLElement>('.comment-reply-slot');
      if (!slot) return;
      if (openReply?.rootId === rootItem.id) {
        closeReplyForm();
        return;
      }
      closeReplyForm();
      const replyForm = createReplyForm(rootItem, rootLi);
      openReply = { rootId: rootItem.id, slot, form: replyForm };
      slot.append(replyForm);
      replyForm.querySelector<HTMLTextAreaElement>('textarea[name="body"]')?.focus();
    }

    function renderItem(item: CommentItem, options: { isReply?: boolean } = {}): HTMLLIElement {
      const isReply = options.isReply === true;
      const itemEl = document.createElement('li');
      itemEl.className = isReply ? 'comment comment-reply' : 'comment';
      itemEl.dataset.commentId = String(item.id);
      itemEl.dataset.reply = isReply ? '1' : '0';

      const avatar = document.createElement('span');
      avatar.className = 'comment-avatar';
      avatar.setAttribute('aria-hidden', 'true');
      avatar.textContent = firstChar(item.author);

      const main = document.createElement('div');
      main.className = 'comment-main';

      const meta = document.createElement('div');
      meta.className = 'comment-meta';

      if (item.website) {
        const link = document.createElement('a');
        link.href = item.website;
        link.textContent = item.author;
        link.rel = 'nofollow ugc noopener';
        link.target = '_blank';
        meta.append(link);
      } else {
        const name = document.createElement('span');
        name.className = 'comment-author';
        name.textContent = item.author;
        meta.append(name);
      }

      const time = document.createElement('time');
      time.className = 'comment-time';
      time.dateTime = item.createdAt;
      time.textContent = formatCommentTime(item.createdAt, lang);
      meta.append(time);

      const body = document.createElement('p');
      body.className = 'comment-body';
      body.textContent = item.body;

      const actions = document.createElement('div');
      actions.className = 'comment-actions-row';
      if (!isReply) {
        const replyButton = document.createElement('button');
        replyButton.type = 'button';
        replyButton.className = 'comment-reply-button';
        const replyCount = Array.isArray(item.replies) ? item.replies.length : Number(item.replyCount ?? 0);
        replyButton.textContent = `${replyLabel}${replyCount > 0 ? ` (${replyCount})` : ''}`;
        replyButton.addEventListener('click', () => openReplyForm(item, itemEl));
        actions.append(replyButton);
      }
      actions.append(renderReactions(item));

      main.append(meta, body, actions);

      if (!isReply) {
        const replies = document.createElement('ul');
        replies.className = 'comment-replies';
        replies.dataset.repliesFor = String(item.id);
        for (const reply of item.replies ?? []) {
          replies.append(renderItem(reply, { isReply: true }));
        }
        const slot = document.createElement('div');
        slot.className = 'comment-reply-slot';
        main.append(replies, slot);
      }

      itemEl.append(avatar, main);
      applyReactionState(item.id);
      return itemEl;
    }

    function appendItems(items: CommentItem[], atTop: boolean) {
      if (!list) return;
      const nodes = items.map((item) => renderItem(item));
      if (atTop) list.prepend(...nodes);
      else list.append(...nodes);
      childCount += nodes.length;
      void loadReactionsFor(items);
    }

    async function load(before?: number) {
      if (loading) return;
      loading = true;
      removeRetry();
      if (before === undefined) setStatus(i18n.loading ?? '');
      try {
        const url = new URL(api, window.location.origin);
        url.searchParams.set('thread', thread);
        url.searchParams.set('limit', String(pageSize));
        if (before !== undefined) url.searchParams.set('before', String(before));

        const response = await fetch(url, { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = (await response.json()) as ListResponse;
        const items = Array.isArray(data.items) ? data.items : [];

        appendItems(items, false);
        total = Number(data.total) || childCount;
        updateCount();
        nextBefore = typeof data.nextBefore === 'number' ? data.nextBefore : null;
        if (more) more.hidden = nextBefore === null;
        setStatus(items.length === 0 && before === undefined ? (i18n.empty ?? '') : '');
      } catch {
        setStatus(i18n.loadError ?? '');
        if (before === undefined && list) {
          list.replaceChildren();
          childCount = 0;
          total = 0;
          updateCount();
          if (more) more.hidden = true;
          const retry = document.createElement('button');
          retry.type = 'button';
          retry.className = 'comment-retry';
          retry.textContent = i18n.retry ?? 'Retry';
          retry.addEventListener('click', () => {
            retry.remove();
            void load();
          });
          list.after(retry);
        }
      } finally {
        loading = false;
      }
    }

    function messageFor(statusCode: number, error?: string): string {
      if (statusCode === 429 || error === 'rate-limited') return i18n.errorRate ?? '';
      if (statusCode === 503 || error === 'db-missing') return i18n.errorUnavailable ?? '';
      if (error === 'too-fast') return i18n.errorQuick ?? '';
      if (statusCode === 400) return i18n.errorInvalid ?? '';
      return i18n.errorFailed ?? '';
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (posting || !form || !submit) return;

      const data = new FormData(form);
      const payload = {
        thread,
        author: String(data.get('author') ?? ''),
        body: String(data.get('body') ?? ''),
        website: String(data.get('website') ?? ''),
        trap: String(data.get('trap') ?? ''),
        elapsed: Date.now() - startedAt,
      };

      posting = true;
      submit.disabled = true;
      const label = submit.textContent ?? '';
      submit.textContent = i18n.submitting ?? '';
      setFormStatus('');

      try {
        const response = await fetch(new URL(api, window.location.origin), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = (await response.json().catch(() => ({}))) as PostResponse;
        if (response.status === 201 && result.item) {
          appendItems([result.item], true);
          total += 1;
          updateCount();
          setStatus('');
          setFormStatus(i18n.posted ?? '');
          if (bodyInput) bodyInput.value = '';
          try {
            if (nameInput) localStorage.setItem(NICKNAME_KEY, nameInput.value);
          } catch {
            /* 隐私模式下 localStorage 可能不可用，忽略 */
          }
        } else {
          setFormStatus(messageFor(response.status, result.error));
        }
      } catch {
        setFormStatus(i18n.errorFailed ?? '');
      } finally {
        posting = false;
        submit.disabled = false;
        submit.textContent = label;
      }
    });

    try {
      const saved = localStorage.getItem(NICKNAME_KEY);
      if (saved && nameInput && !nameInput.value) nameInput.value = saved;
    } catch {
      /* 忽略 */
    }

    more?.addEventListener('click', () => {
      if (nextBefore !== null) void load(nextBefore);
    });

    void load();
  }

  initComments();
  document.addEventListener('astro:page-load', initComments);
</script>

<style is:global>
  /* 客户端会动态插入评论节点，所以用 #comments 作用域而不是 Astro 的组件作用域。 */
  #comments {
    max-width: var(--maxw);
    margin: var(--space-6) auto 0;
    padding-top: var(--space-4);
    border-top: 2px solid var(--line);
  }

  #comments .comments-head {

---
import { withBase } from '../lib/url';
interface Props {
  name: string;
  alt?: string;
  size?: number;
  class?: string;
}
const { name, alt = '', size = 48, class: className = '' } = Astro.props;
---
<img
  class={`px-sprite ${className}`}
  src={withBase(`pixel/${name}.png`)}
  style={`width:${size}px;height:${size}px`}
  alt={alt}
  width={size}
  height={size}
  loading="lazy"
  decoding="async"
/>

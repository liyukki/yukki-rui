---
/**
 * 全站 AI 聊天小窗。
 *
 * 所有请求都发往本站 /api/chat；Cloudflare Pages Function 持有密钥并代理上游。
 * UI 只追加一个固定定位层，不改变页面原有布局。
 */
import { AI_CHAT, SITE, UI, type Lang } from '../consts';
import { chatEndpoint, chatI18n } from '../lib/chat';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
  articleId?: string;
}

const { lang, articleId } = Astro.props;
const t = UI[lang];
const endpoint = chatEndpoint(SITE.url, AI_CHAT.origin);
const gifSrc = withBase('chat/yukki-chat.gif');
const staticSrc = withBase('chat/yukki-chat-static.png');
const indexSrc = withBase(`ai/${lang}.json`);
const i18n = chatI18n(lang);
---

{AI_CHAT.enabled && (
  <aside
    class="ai-chat"
    id="ai-chat"
    transition:persist="ai-chat"
    data-api={endpoint}
    data-lang={lang}
    data-context-enabled={AI_CHAT.contextEnabled ? '1' : '0'}
    data-index={indexSrc}
    data-article-id={articleId ?? ''}
    data-max-input={String(AI_CHAT.maxInputLength)}
    data-max-messages={String(AI_CHAT.maxMessages)}
    data-i18n={JSON.stringify(i18n)}
    data-pagefind-ignore
  >
    <button
      type="button"
      class="ai-chat-launcher"
      data-chat-launcher
      aria-label={t.aiOpen}
      aria-controls="ai-chat-panel"
      aria-expanded="false"
    >
      <span class="ai-chat-launcher-halo" aria-hidden="true"></span>
      <img class="ai-chat-gif pixelated" src={gifSrc} width="104" height="177" alt="" />
      <img class="ai-chat-static pixelated" src={staticSrc} width="104" height="177" alt="" />
    </button>

    <section
      class="ai-chat-panel"
      id="ai-chat-panel"
      role="dialog"
      aria-modal="false"
      aria-label={t.aiTitle}
      aria-busy="false"
      data-chat-panel
      hidden
    >
      <header class="ai-chat-head">
        <span class="ai-chat-avatar" aria-hidden="true">
          <img class="pixelated" src={staticSrc} width="30" height="51" alt="" />
        </span>
        <div class="ai-chat-identity">
          <strong data-chat-title>{t.aiTitle}</strong>
          <span class="ai-chat-status"><i aria-hidden="true"></i><span data-chat-online>{t.aiOnline}</span></span>
        </div>
        <button type="button" class="ai-chat-head-btn" data-chat-clear aria-label={t.aiClear} title={t.aiClear}>
          {lang === 'zh' ? '清空' : 'CLR'}
        </button>
        <button type="button" class="ai-chat-head-btn ai-chat-close" data-chat-close aria-label={t.aiClose} title={t.aiClose}>
          ×
        </button>
      </header>

      <div class="ai-chat-log" data-chat-log role="log" aria-live="polite" aria-relevant="additions text">
        <div class="ai-chat-message is-assistant">
          <span class="ai-chat-message-avatar" aria-hidden="true">Y</span>
          <p class="ai-chat-bubble" data-chat-welcome>{t.aiWelcome}</p>
        </div>
      </div>

      <div class="ai-chat-quick" data-chat-quick hidden>
        <button type="button" data-chat-prompt={t.aiQuickSummary}>{t.aiQuickSummary}</button>
        <button type="button" data-chat-prompt={t.aiQuickPoints}>{t.aiQuickPoints}</button>
        <button type="button" data-chat-prompt={t.aiQuickExplain}>{t.aiQuickExplain}</button>
        <button type="button" data-chat-prompt={t.aiQuickRelated}>{t.aiQuickRelated}</button>
      </div>

      <form class="ai-chat-composer" data-chat-form>
        <label class="ai-chat-sr-only" for="ai-chat-input" data-chat-input-label>{t.aiPlaceholder}</label>
        <textarea
          id="ai-chat-input"
          data-chat-input
          rows="1"
          maxlength={AI_CHAT.maxInputLength}
          placeholder={t.aiPlaceholder}
          autocomplete="off"
        ></textarea>
        <div class="ai-chat-composer-foot">
          <span class="ai-chat-hint" data-chat-hint>{t.aiInputHint}</span>
          <span class="ai-chat-counter" data-chat-counter>0/{AI_CHAT.maxInputLength}</span>
          <button type="button" class="ai-chat-send" data-chat-send>{t.aiSend}</button>
        </div>
      </form>
    </section>
  </aside>
)}

<script>
  import {
    parseAiIndex,
    type AiIndex,
    type AiSource,
  } from '../lib/ai-context';
  import {
    buildChatRequestPayload,
    chatApiUrl,
    chatI18n,
    createSseParser,
    extractChatDelta,
    normalizeChatMessages,
    resolveChatPageContext,
    shouldShowQuickPrompts,
    type ChatI18n,
    type ChatMessage,
  } from '../lib/chat';

  type Lang = 'zh' | 'en';
  type ChatMessageView = {
    row: HTMLDivElement;
    bubble: HTMLParagraphElement;
    main: HTMLDivElement;
  };


  function initAiChat(): void {
    const chatRoot = document.getElementById('ai-chat');
    if (!chatRoot) return;
    const root: HTMLElement = chatRoot;

    type RefreshableRoot = HTMLElement & { __aiChatRefresh?: () => void };
    const refreshable = root as RefreshableRoot;
    if (root.dataset.ready === '1') {
      refreshable.__aiChatRefresh?.();
      return;
    }
    root.dataset.ready = '1';

    let activeLang: Lang = root.dataset.lang === 'en' ? 'en' : 'zh';
    let i18n: ChatI18n = chatI18n(activeLang);

    const launcher = root.querySelector<HTMLButtonElement>('[data-chat-launcher]')!;
    const panel = root.querySelector<HTMLElement>('[data-chat-panel]')!;
    const log = root.querySelector<HTMLElement>('[data-chat-log]')!;
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!;
    const input = root.querySelector<HTMLTextAreaElement>('[data-chat-input]')!;
    const counter = root.querySelector<HTMLElement>('[data-chat-counter]')!;
    const sendButton = root.querySelector<HTMLButtonElement>('[data-chat-send]')!;
    const clearButton = root.querySelector<HTMLButtonElement>('[data-chat-clear]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-chat-close]');
    const title = root.querySelector<HTMLElement>('[data-chat-title]');
    const online = root.querySelector<HTMLElement>('[data-chat-online]');
    const inputLabel = root.querySelector<HTMLElement>('[data-chat-input-label]');
    const hint = root.querySelector<HTMLElement>('[data-chat-hint]');
    if (!launcher || !panel || !log || !form || !input || !counter || !sendButton) return;

    const quick = root.querySelector<HTMLElement>('[data-chat-quick]');
    const contextEnabled = root.dataset.contextEnabled === '1';
    let indexSrcPath = root.dataset.index ?? '';
    let indexPromise: Promise<AiIndex | null> | null = null;
    let indexUnavailable = false;
    let indexNoticeShown = false;

    const maxInput = Math.max(1, Number(root.dataset.maxInput) || 2000);
    const maxMessages = Math.max(1, Number(root.dataset.maxMessages) || 20);
    const endpoint = root.dataset.api ?? '';
    const api = () => chatApiUrl(window.location.origin, endpoint);

    let history: ChatMessage[] = [];
    let controller: AbortController | null = null;
    let generating = false;
    let requestSeq = 0;
    let composing = false;

    function messageError(): string {
      if (activeLang === 'en') {
        return i18n.failed || 'Something went wrong. Please try again.';
      }
      return i18n.failed || '出了点问题，请稍后再试。';
    }

    function errorText(status: number, code?: string): string {
      if (code === 'ai-not-configured' || code === 'rate-limit-unavailable') return i18n.notConfigured;
      if (code === 'upstream-auth') return i18n.authFailed;
      if (code === 'ai-rate-limited' || code === 'rate-limited' || status === 429) return i18n.rateLimited;
      if (code === 'upstream-unavailable' || code === 'upstream-invalid' || status >= 500) return i18n.unavailable;
      if (status === 400 || code?.startsWith('invalid-') || code === 'payload-too-large') return i18n.invalid;
      return messageError();
    }

    function scrollToBottom(): void {
      requestAnimationFrame(() => {
        log.scrollTop = log.scrollHeight;
      });
    }

    function currentPageMarker(): HTMLElement | null {
      return document.querySelector<HTMLElement>('[data-ai-page-context]');
    }

    function applyI18n(): void {
      if (title) title.textContent = i18n.title;
      if (online) online.textContent = i18n.online;
      launcher.setAttribute('aria-label', i18n.open);
      panel.setAttribute('aria-label', i18n.title);
      if (clearButton) {
        clearButton.textContent = activeLang === 'zh' ? '清空' : 'CLR';
        clearButton.setAttribute('aria-label', i18n.clear);
        clearButton.title = i18n.clear;
      }
      if (closeButton) {
        closeButton.setAttribute('aria-label', i18n.close);
        closeButton.title = i18n.close;
      }
      if (inputLabel) inputLabel.textContent = i18n.placeholder;
      input.placeholder = i18n.placeholder;
      if (hint) hint.textContent = i18n.inputHint;
      sendButton.textContent = generating ? i18n.stop : i18n.send;
      sendButton.setAttribute('aria-label', generating ? i18n.stop : i18n.send);

      const welcome = log.querySelector<HTMLElement>('[data-chat-welcome]');
      if (welcome && history.length === 0) welcome.textContent = i18n.welcome;

      const prompts = [i18n.quickSummary, i18n.quickPoints, i18n.quickExplain, i18n.quickRelated];
      const promptButtons = root.querySelectorAll<HTMLButtonElement>('[data-chat-prompt]');
      promptButtons.forEach((button, index) => {
        const prompt = prompts[index];
        if (!prompt) return;
        button.textContent = prompt;
        button.dataset.chatPrompt = prompt;
      });

      const thinkingLabel = log.querySelector<HTMLElement>('[data-chat-thinking-label]');
      if (thinkingLabel) thinkingLabel.textContent = i18n.thinking;
      for (const label of root.querySelectorAll<HTMLElement>('.ai-chat-sources > strong')) {
        label.textContent = i18n.sources;
      }
    }

    function currentArticleId(): string {
      const marker = currentPageMarker();
      return marker ? marker.dataset.articleId ?? '' : root.dataset.articleId ?? '';
    }

    function syncPageContext(): void {
      const marker = currentPageMarker();
      const nextContext = resolveChatPageContext(
        marker ? { lang: marker.dataset.lang, articleId: marker.dataset.articleId } : null,
        { lang: activeLang, articleId: root.dataset.articleId ?? '' },
      );
      activeLang = nextContext.lang;
      i18n = chatI18n(activeLang);
      root.dataset.lang = activeLang;
      root.dataset.articleId = nextContext.articleId;
      root.dataset.i18n = JSON.stringify(i18n);

      const nextIndexPath = (root.dataset.index ?? '').replace(/(?:zh|en)\.json$/u, `${activeLang}.json`);
      root.dataset.index = nextIndexPath;
      if (nextIndexPath && nextIndexPath !== indexSrcPath) {
        indexSrcPath = nextIndexPath;
        indexPromise = null;
        indexUnavailable = false;
        indexNoticeShown = false;
      }
      applyI18n();
      updateQuickVisibility();
    }

    function updateQuickVisibility(): void {
      if (!quick) return;
      quick.hidden = !shouldShowQuickPrompts(contextEnabled, currentArticleId(), history.length);
    }

    function loadIndex(): Promise<AiIndex | null> {
      if (!contextEnabled || !indexSrcPath) return Promise.resolve(null);
      indexPromise ??= fetch(indexSrcPath, { headers: { Accept: 'application/json' } })
        .then((response) => (response.ok ? response.json() : null))
        .then((value) => parseAiIndex(value))
        .catch(() => null)
        .then((index) => {
          indexUnavailable = !index;
          return index;
        });
      return indexPromise;
    }

    function sourceHref(source: AiSource): string {
      if (typeof source.url !== 'string') return '';
      const unsafePathPart = (value: string): boolean =>
        /[\u0000-\u001f\u007f-\u009f\s]/u.test(value)
        || value.includes('//')
        || value.includes('..')
        || value.includes('\\')
        || /[?#]/u.test(value);

      if (
        !source.url.startsWith('/')
        || source.url.startsWith('//')
        || source.url.includes('//')
        || /[\u0000-\u001f\u007f-\u009f\s]/u.test(source.url)
        || source.url.includes('..')
        || source.url.includes('\\')
        || /[?#]/u.test(source.url)
        || /%(?![0-9a-f]{2})/iu.test(source.url)
      ) {
        return '';
      }

      let decoded = source.url;
      while (/%[0-9a-f]{2}/iu.test(decoded)) {
        try {
          decoded = decodeURIComponent(decoded);
        } catch {
          return '';
        }
        if (unsafePathPart(decoded) || /%(?![0-9a-f]{2})/iu.test(decoded)) return '';
      }

      try {
        return source.url + (source.anchor ? `#${encodeURIComponent(source.anchor)}` : '');
      } catch {
        return '';
      }
    }

    function createMessage(role: 'user' | 'assistant', text: string) {
      const row = document.createElement('div');
      row.className = `ai-chat-message is-${role}`;
      const avatar = document.createElement('span');
      avatar.className = 'ai-chat-message-avatar';
      avatar.setAttribute('aria-hidden', 'true');
      avatar.textContent = role === 'user' ? 'YOU' : 'Y';
      const main = document.createElement('div');
      main.className = 'ai-chat-message-main';
      const bubble = document.createElement('p');
      bubble.className = 'ai-chat-bubble';
      bubble.textContent = text;
      main.append(bubble);
      row.append(avatar, main);
      return { row, bubble, main };
    }

    function renderSources(container: HTMLElement, sources: AiSource[]): void {
      if (!sources.length) return;
      const section = document.createElement('section');
      section.className = 'ai-chat-sources';
      const label = document.createElement('strong');
      label.textContent = i18n.sources;
      const list = document.createElement('ol');
      for (const source of sources) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = sourceHref(source);
        if (!link.getAttribute('href')) link.removeAttribute('href');
        link.textContent = `${source.title}${source.heading && source.heading !== source.title ? ` — ${source.heading}` : ''}`;
        item.append(link);
        list.append(item);
      }
      section.append(label, list);
      container.append(section);
    }

    function appendMessage(role: 'user' | 'assistant', text: string) {
      const message = createMessage(role, text);
      log.append(message.row);
      scrollToBottom();
      return message;
    }

    function appendNotice(text: string): void {
      const row = document.createElement('div');
      row.className = 'ai-chat-message is-notice';
      const bubble = document.createElement('p');
      bubble.className = 'ai-chat-bubble';
      bubble.setAttribute('role', 'status');
      bubble.textContent = text;
      row.append(bubble);
      log.append(row);
      scrollToBottom();
    }

    let thinking: HTMLElement | null = null;
    function setThinking(show: boolean): void {
      if (show && !thinking) {
        thinking = document.createElement('div');
        thinking.className = 'ai-chat-thinking';
        thinking.setAttribute('role', 'status');
        const label = document.createElement('span');
        label.className = 'ai-chat-thinking-label';
        label.dataset.chatThinkingLabel = '';
        label.textContent = i18n.thinking;
        const dots = document.createElement('span');
        dots.className = 'ai-chat-dots';
        dots.setAttribute('aria-hidden', 'true');
        dots.append(document.createElement('i'), document.createElement('i'), document.createElement('i'));
        thinking.append(label, dots);
        log.append(thinking);
        scrollToBottom();
      } else if (!show && thinking) {
        thinking.remove();
        thinking = null;
      }
    }

    function setBusy(busy: boolean): void {
      generating = busy;
      panel.setAttribute('aria-busy', String(busy));
      sendButton.textContent = busy ? i18n.stop : i18n.send;
      sendButton.setAttribute('aria-label', busy ? i18n.stop : i18n.send);
      sendButton.classList.toggle('is-stop', busy);
      sendButton.disabled = busy ? false : input.value.trim() === '';
    }

    function updateCounter(): void {
      const count = [...input.value].length;
      counter.textContent = `${count}/${maxInput}`;
      counter.classList.toggle('is-near', count >= maxInput * 0.9);
      sendButton.disabled = !generating && input.value.trim() === '';
    }

    function resizeInput(): void {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 112)}px`;
    }

    function resetConversation(): void {
      requestSeq += 1;
      controller?.abort();
      controller = null;
      history = [];
      input.value = '';
      setThinking(false);
      setBusy(false);
      log.replaceChildren();
      const welcome = createMessage('assistant', i18n.welcome);
      welcome.bubble.dataset.chatWelcome = '';
      log.append(welcome.row);
      updateQuickVisibility();
      updateCounter();
      resizeInput();
      scrollToBottom();
    }

    function setOpen(open: boolean): void {
      panel.hidden = !open;
      launcher.hidden = open;
      launcher.setAttribute('aria-expanded', String(open));
      if (open) {
        requestAnimationFrame(() => {
          input.focus();
          scrollToBottom();
        });
      } else {
        launcher.focus();
      }
    }

    async function responseError(response: Response): Promise<{ code: string; status: number }> {
      try {
        const data = (await response.json()) as { error?: unknown };
        return { code: typeof data.error === 'string' ? data.error : '', status: response.status };
      } catch {
        return { code: '', status: response.status };
      }
    }

    async function sendMessage(): Promise<void> {
      if (generating) return;
      const text = input.value.trim();
      if (!text) return;

      const messages = normalizeChatMessages([...history, { role: 'user', content: text }], maxMessages);
      if (messages.length === 0 || messages[messages.length - 1]?.role !== 'user') return;

      const token = ++requestSeq;
      history.push({ role: 'user', content: text });
      updateQuickVisibility();
      appendMessage('user', text);
      input.value = '';
      updateCounter();
      resizeInput();
      setThinking(true);
      controller = new AbortController();
      setBusy(true);

      let received = '';
      let assistantMessage: ChatMessageView | null = null;
      let sentSources: AiSource[] = [];
      let contextUnavailable = false;

      try {
        const index = await loadIndex();
        contextUnavailable = indexUnavailable;
        const payload = buildChatRequestPayload(messages, text, activeLang, currentArticleId(), index);
        sentSources = payload.context?.sources ?? [];

        const response = await fetch(api(), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'text/event-stream' },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });

        if (!response.ok) {
          const detail = await responseError(response);
          if (token === requestSeq) appendNotice(errorText(detail.status, detail.code));
          return;
        }
        if (!response.body) {
          if (token === requestSeq) appendNotice(i18n.noReply);
          return;
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        const parser = createSseParser((data) => {
          if (token !== requestSeq || data === '[DONE]') return;
          const delta = extractChatDelta(data);
          if (!delta) return;
          if (!assistantMessage) {
            assistantMessage = appendMessage('assistant', '');
            setThinking(false);
          }
          received += delta;
          assistantMessage.bubble.textContent = received;
          scrollToBottom();
        });

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          parser.push(decoder.decode(value, { stream: true }));
        }
        parser.push(decoder.decode());
        parser.finish();

        if (token === requestSeq && !received) appendNotice(i18n.noReply);
        const finalAssistant = assistantMessage as ChatMessageView | null;
        if (token === requestSeq && received && finalAssistant) renderSources(finalAssistant.main, sentSources);
        if (token === requestSeq && contextUnavailable && !indexNoticeShown) {
          indexNoticeShown = true;
          appendNotice(i18n.contextUnavailable);
        }
      } catch (error) {
        if (token === requestSeq && !(error instanceof DOMException && error.name === 'AbortError')) {
          if (!received) appendNotice(messageError());
        }
      } finally {
        if (token === requestSeq) {
          if (received) history.push({ role: 'assistant', content: received });
          setThinking(false);
          controller = null;
          setBusy(false);
          input.focus();
        }
      }
    }

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-chat-prompt]')) {
      button.addEventListener('click', () => {
        input.value = button.dataset.chatPrompt ?? '';
        updateCounter();
        resizeInput();
        input.focus();
        void sendMessage();
      });
    }

    launcher.addEventListener('click', () => setOpen(Boolean(panel.hidden)));
    closeButton?.addEventListener('click', () => setOpen(false));
    clearButton?.addEventListener('click', () => {
      resetConversation();
      input.focus();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void sendMessage();
    });

    sendButton.addEventListener('click', () => {
      if (generating) {
        controller?.abort();
        return;
      }
      void sendMessage();
    });

    input.addEventListener('input', () => {
      updateCounter();
      resizeInput();
    });

    input.addEventListener('compositionstart', () => {
      composing = true;
    });
    input.addEventListener('compositionend', () => {
      composing = false;
    });

    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || event.shiftKey || event.isComposing || composing) return;
      event.preventDefault();
      void sendMessage();
    });

    document.addEventListener('keydown', (event) => {
      if (!root.isConnected || event.key !== 'Escape' || panel.hidden) return;
      setOpen(false);
    });

    refreshable.__aiChatRefresh = syncPageContext;
    syncPageContext();

    updateCounter();
    resizeInput();
  }

  initAiChat();
  document.addEventListener('astro:page-load', initAiChat);
</script>
<style is:global>
  #ai-chat {
    position: fixed;
    inset: 0;
    z-index: 30;
    pointer-events: none;
    color: var(--text);
    font-family: var(--font-sans);
  }

  #ai-chat [hidden] {
    display: none !important;
  }

  #ai-chat .ai-chat-launcher {
    position: absolute;
    right: 18px;
    bottom: 16px;
    width: 86px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
    transition: transform var(--dur) var(--ease-pop);
  }

  #ai-chat .ai-chat-launcher:hover {
    transform: translateY(-4px) scale(1.03);
  }

  #ai-chat .ai-chat-launcher:active {
    transform: translateY(1px) scale(0.99);
  }

  #ai-chat .ai-chat-launcher img {
    position: relative;
    z-index: 1;
    display: block;
    width: 86px;
    height: auto;
    filter: drop-shadow(0 3px 3px rgba(0, 0, 0, 0.09));
    animation: ai-chat-bob 3.2s ease-in-out infinite;
    transition: filter var(--dur);
  }

  #ai-chat .ai-chat-launcher:hover img {
    filter: drop-shadow(0 5px 5px rgba(0, 0, 0, 0.12));
  }

  #ai-chat .ai-chat-launcher .ai-chat-static {
    display: none;
  }

  #ai-chat .ai-chat-launcher-halo {
    position: absolute;
    z-index: 0;
    left: 50%;
    bottom: 0;
    width: 44px;
    height: 9px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 0, 0, 0.16) 0%,
      rgba(0, 0, 0, 0.08) 42%,
      transparent 74%
    );
    opacity: 0.58;
    filter: blur(2.4px);
    transform: translateX(-50%);
    transform-origin: center;
    animation: ai-chat-shadow 3.2s ease-in-out infinite;
  }

  #ai-chat .ai-chat-panel {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    width: min(370px, calc(100vw - 24px));

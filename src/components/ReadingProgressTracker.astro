---
import type { Lang } from '../consts';

interface Props {
  postId: string;
  lang: Lang;
  title: string;
  href: string;
}

const { postId, lang, title, href } = Astro.props;
const entry = { id: postId, lang, title, href };
---
<div data-reading-tracker data-entry={JSON.stringify(entry)} hidden></div>

<script>
  import {
    personalLibraryKey,
    readPersonalLibrary,
    recordReading,
    writePersonalLibrary,
    type PersonalLibraryLang,
    type ReadingRecord,
  } from '../lib/personal-library';
  import {
    readingProgressAt,
    scrollTargetForProgress,
  } from '../lib/reading-position';

  interface TrackerEntry {
    id: string;
    lang: PersonalLibraryLang;
    title: string;
    href: string;
  }

  interface ResumeRequest {
    progress: number | null;
    anchor: string | null;
    offset: number | null;
  }

  function readEntry(root: HTMLElement): TrackerEntry | null {
    try {
      const value = JSON.parse(root.dataset.entry ?? '{}') as Record<string, unknown>;
      if (
        typeof value.id !== 'string' ||
        (value.lang !== 'zh' && value.lang !== 'en') ||
        typeof value.title !== 'string' ||
        typeof value.href !== 'string'
      ) {
        return null;
      }
      return {
        id: value.id,
        lang: value.lang,
        title: value.title,
        href: value.href,
      };
    } catch {
      return null;
    }
  }

  function getStorage(): Storage | null {
    try {
      return window.localStorage;
    } catch {
      return null;
    }
  }

  function readResumeRequest(): ResumeRequest | null {
    const url = new URL(window.location.href);
    const query = url.searchParams;
    if (!query.has('resume') && !query.has('anchor') && !query.has('offset')) {
      return null;
    }

    const rawProgress = Number.parseFloat(query.get('resume') ?? '');
    const rawOffset = Number.parseFloat(query.get('offset') ?? '');
    const rawAnchor = (query.get('anchor') ?? '').trim();
    return {
      progress:
        Number.isFinite(rawProgress) && rawProgress >= 0 && rawProgress <= 100
          ? rawProgress
          : null,
      anchor: rawAnchor.length > 0 && rawAnchor.length <= 200 ? rawAnchor : null,
      offset:
        Number.isFinite(rawOffset) && Math.abs(rawOffset) <= 1_000_000
          ? Math.round(rawOffset)
          : null,
    };
  }

  function clearResumeUrl(): void {
    const url = new URL(window.location.href);
    url.searchParams.delete('resume');
    url.searchParams.delete('anchor');
    url.searchParams.delete('offset');
    url.hash = '';
    history.replaceState(history.state, '', `${url.pathname}${url.search}`);
  }

  function watchedReading(entry: TrackerEntry): ReadingRecord | null {
    const library = readPersonalLibrary(getStorage());
    return (
      library.history.find(
        (record) =>
          personalLibraryKey(record.lang, record.id) ===
          personalLibraryKey(entry.lang, entry.id),
      ) ?? null
    );
  }

  function readingSignature(record: ReadingRecord): string {
    return [
      record.progress,
      record.resumeAnchor ?? '',
      record.resumeOffset ?? '',
    ].join(':');
  }

  async function waitForArticleLayout(body: HTMLElement): Promise<void> {
    const pendingImages = [...body.querySelectorAll<HTMLImageElement>('img')]
      .filter((image) => !image.complete)
      .map(
        (image) =>
          new Promise<void>((resolve) => {
            const settle = (): void => resolve();
            image.addEventListener('load', settle, { once: true });
            image.addEventListener('error', settle, { once: true });
            window.setTimeout(settle, 2500);
          }),
      );

    await Promise.all(pendingImages);
    try {
      await document.fonts.ready;
    } catch {
      // Font loading is best-effort; layout can still settle without it.
    }
    await new Promise<void>((resolve) =>
      window.requestAnimationFrame(() => window.requestAnimationFrame(() => resolve())),
    );
  }

  let controller: AbortController | null = null;
  let cleanup: (() => void) | null = null;
  let activeRoot: HTMLElement | null = null;

  function init(): void {
    const root = document.querySelector<HTMLElement>('[data-reading-tracker]');
    if (!root) {
      return;
    }
    if (controller && activeRoot === root) return;

    cleanup?.();
    controller?.abort();

    const entry = readEntry(root);
    if (!entry) return;

    const activeController = new AbortController();
    const { signal } = activeController;
    controller = activeController;
    activeRoot = root;

    const body = document.querySelector<HTMLElement>('.post-body');
    if (!body) {
      activeController.abort();
      controller = null;
      activeRoot = null;
      return;
    }

    const previous = watchedReading(entry);
    let lastSignature = previous ? readingSignature(previous) : '';
    let frame = 0;
    let paused = false;
    let destroyed = false;
    let hasUserIntent = false;

    const currentBounds = () => ({
      bodyTop: body.getBoundingClientRect().top + window.scrollY,
      bodyHeight: body.offsetHeight,
      viewportHeight: window.innerHeight,
    });

    const currentProgress = (): number => {
      return readingProgressAt(window.scrollY, currentBounds());
    };

    const currentResumePosition = (): Pick<ReadingRecord, 'resumeAnchor' | 'resumeOffset'> => {
      const headings = [
        ...body.querySelectorAll<HTMLElement>('h2[id], h3[id]'),
      ];
      if (headings.length === 0) return {};

      const header = document.querySelector<HTMLElement>('.site-header');
      const readingLine = Math.max(0, header?.getBoundingClientRect().bottom ?? 0) + 24;
      let nearest = headings[0];
      for (const heading of headings) {
        const distance = Math.abs(heading.getBoundingClientRect().top - readingLine);
        const nearestDistance = Math.abs(
          nearest.getBoundingClientRect().top - readingLine,
        );
        if (distance < nearestDistance) nearest = heading;
      }
      return {
        resumeAnchor: nearest.id,
        resumeOffset: Math.round(nearest.getBoundingClientRect().top),
      };
    };

    const flush = (): void => {
      if (!hasUserIntent) return;
      const progress = currentProgress();

      const resumePosition = currentResumePosition();
      const storage = getStorage();
      const library = readPersonalLibrary(storage);
      const record: ReadingRecord = {
        ...entry,
        progress,
        updatedAt: Date.now(),
        ...resumePosition,
      };
      const signature = readingSignature(record);
      if (signature === lastSignature) return;

      const next = recordReading(library, record);
      writePersonalLibrary(storage, next);
      lastSignature = signature;
    };

    const schedule = (): void => {
      if (frame || paused || destroyed) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        flush();
      });
    };

    const markActivity = (): void => {
      schedule();
    };

    cleanup = (): void => {
      destroyed = true;
      if (frame) {
        window.cancelAnimationFrame(frame);
        frame = 0;
      }
      if (controller === activeController) controller = null;
      if (activeRoot === root) activeRoot = null;
    };

    const markUserIntent = (): void => {
      hasUserIntent = true;
    };

    window.addEventListener('scroll', markActivity, { signal, passive: true });
    window.addEventListener('wheel', markUserIntent, { signal, passive: true });
    window.addEventListener('touchstart', markUserIntent, { signal, passive: true });
    window.addEventListener('keydown', markUserIntent, { signal });
    window.addEventListener('pointerdown', markUserIntent, { signal, passive: true });
    window.addEventListener('resize', schedule, { signal, passive: true });
    window.addEventListener(
      'pagehide',
      () => {
        flush();
        paused = true;
      },
      { signal },
    );
    window.addEventListener(
      'pageshow',
      () => {
        paused = false;
        schedule();
      },
      { signal },
    );
    document.addEventListener(
      'visibilitychange',
      () => {
        if (document.visibilityState === 'hidden') {
          flush();
          paused = true;
          return;
        }
        paused = false;
        schedule();
      },
      { signal },
    );

    const restore = async (): Promise<void> => {
      const request = readResumeRequest();
      if (!request) {
        flush();
        return;
      }

      await waitForArticleLayout(body);
      if (destroyed) return;

      const bounds = currentBounds();
      const anchor =
        request.anchor !== null ? document.getElementById(request.anchor) : null;
      let target: number | null = null;

      if (anchor && body.contains(anchor)) {
        const anchorTop = anchor.getBoundingClientRect().top + window.scrollY;
        target = anchorTop - (request.offset ?? 0);
      } else if (request.progress !== null) {
        target = scrollTargetForProgress(request.progress, bounds);
      }

      if (target === null) {
        clearResumeUrl();
        flush();
        return;
      }

      const maxScroll = Math.max(
        0,
        document.documentElement.scrollHeight - window.innerHeight,
      );
      const previousScrollBehavior = document.documentElement.style.scrollBehavior;
      document.documentElement.style.scrollBehavior = 'auto';
      window.scrollTo(0, Math.min(maxScroll, Math.max(0, target)));
      document.documentElement.style.scrollBehavior = previousScrollBehavior;
      await new Promise<void>((resolve) =>
        window.requestAnimationFrame(() =>
          window.requestAnimationFrame(() => resolve()),
        ),
      );
      if (destroyed) return;
      clearResumeUrl();
      flush();
    };

    void restore();
  }

  const start = (): void => {
    if (document.querySelector('[data-reading-tracker]')) init();
  };

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    controller?.abort();
    cleanup = null;
    controller = null;
    activeRoot = null;
  });
  document.addEventListener('astro:page-load', start);
  if (document.readyState !== 'loading') start();
</script>

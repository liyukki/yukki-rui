---
import { UI, type Lang } from '../consts';

interface Props {
  postId: string;
  lang: Lang;
  title: string;
}

const { postId, lang, title } = Astro.props;
const t = UI[lang];
const i18n = {
  annotations: t.annotations,
  annotationsOpen: t.annotationsOpen,
  annotationsEmpty: t.annotationsEmpty,
  annotationsEmptyHint: t.annotationsEmptyHint,
  annotationHighlight: t.annotationHighlight,
  annotationAddNote: t.annotationAddNote,
  annotationEdit: t.annotationEdit,
  annotationJump: t.annotationJump,
  annotationQuote: t.annotationQuote,
  annotationNote: t.annotationNote,
  annotationNotePlaceholder: t.annotationNotePlaceholder,
  annotationSave: t.annotationSave,
  annotationSaved: t.annotationSaved,
  annotationDelete: t.annotationDelete,
  annotationDeleted: t.annotationDeleted,
  annotationCancel: t.annotationCancel,
  annotationClose: t.annotationClose,
  annotationStorageUnavailable: t.annotationStorageUnavailable,
  annotationInvalidSelection: t.annotationInvalidSelection,
  annotationTooLong: t.annotationTooLong,
  annotationOverlap: t.annotationOverlap,
  annotationSaveFailed: t.annotationSaveFailed,
  annotationDeleteFailed: t.annotationDeleteFailed,
  annotationMoved: t.annotationMoved,
  annotationConflict: t.annotationConflict,
  annotationJumped: t.annotationJumped,
  annotationToolbar: t.annotationToolbar,
  annotationExcerpts: t.annotationExcerpts,
};
---
<div
  class="article-annotations"
  data-article-annotations
  data-post-id={postId}
  data-lang={lang}
  data-i18n={JSON.stringify(i18n).replace(/</g, '\\u003c')}
>
  <button
    type="button"
    class="annotation-entry"
    data-annotations-open
    aria-haspopup="dialog"
    aria-controls="article-annotations-dialog"
    aria-expanded="false"
    aria-label={`${t.annotationsOpen}: ${title}`}
    hidden
  >
    <span>{t.annotations}</span>
    <span class="annotation-entry__count" data-annotations-count>0</span>
  </button>

  <div
    class="annotation-toolbar"
    data-annotation-toolbar
    role="toolbar"
    aria-label={t.annotationToolbar}
    hidden
  >
    <button type="button" data-annotation-highlight>{t.annotationHighlight}</button>
    <button
      type="button"
      data-annotation-note
      aria-haspopup="dialog"
      aria-controls="article-annotation-editor"
      aria-expanded="false"
    >{t.annotationAddNote}</button>
  </div>

  <p
    class="annotation-status"
    data-annotation-status
    role="status"
    aria-live="polite"
  ></p>

  <dialog
    class="annotation-drawer"
    id="article-annotations-dialog"
    data-annotations-dialog
    aria-labelledby="article-annotations-title"
  >
    <header class="annotation-drawer__header">
      <h2 id="article-annotations-title">{t.annotations}</h2>
      <button
        type="button"
        class="annotation-icon-button"
        data-annotations-close
        aria-label={t.annotationClose}
      ><span aria-hidden="true">&times;</span></button>
    </header>
    <div class="annotation-drawer__body">
      <p class="annotation-empty" data-annotations-empty>
        <strong>{t.annotationsEmpty}</strong>
        <span>{t.annotationsEmptyHint}</span>
      </p>
      <ol class="annotation-list" data-annotations-list></ol>
    </div>
  </dialog>

  <dialog
    class="annotation-editor"
    id="article-annotation-editor"
    data-annotation-editor
    aria-labelledby="article-annotation-editor-title"
  >
    <form method="dialog" data-annotation-form>
      <header class="annotation-editor__header">
        <h2 id="article-annotation-editor-title" data-annotation-editor-title>
          {t.annotationAddNote}
        </h2>
        <button
          type="button"
          class="annotation-icon-button"
          data-annotation-cancel
          aria-label={t.annotationClose}
        ><span aria-hidden="true">&times;</span></button>
      </header>
      <blockquote class="annotation-editor__quote" data-annotation-quote></blockquote>
      <label class="annotation-editor__field">
        <span>{t.annotationNote}</span>
        <textarea
          data-annotation-note-input
          maxlength="1000"
          placeholder={t.annotationNotePlaceholder}
        ></textarea>
      </label>
      <div class="annotation-editor__actions">
        <button type="submit" value="save" data-annotation-save>{t.annotationSave}</button>
        <button type="button" data-annotation-delete hidden>{t.annotationDelete}</button>
        <button type="button" data-annotation-cancel>{t.annotationCancel}</button>
      </div>
    </form>
  </dialog>
</div>

<script>
  import { UI, type Lang } from '../consts';
  import {
    ANNOTATION_QUOTE_LIMIT,
    ANNOTATION_STORAGE_KEY,
    createAnnotationAnchor,
    createAnnotationRecord,
    readAnnotationStore,
    removeAnnotation,
    resolveAnnotationAnchors,
    selectAnnotationsForPost,
    updateAnnotationNote,
    upsertAnnotation,
    writeAnnotationStore,
    type AnnotationAnchor,
    type AnnotationLang,
    type AnnotationRecord,
    type AnnotationStore,
  } from '../lib/annotations';

  const EXCLUDED =
    'script, style, button, input, select, textarea, svg, [data-annotation-ignore]';

  interface TextSegment {
    node: Text;
    start: number;
    end: number;
  }

  interface SelectionSnapshot {
    anchor: ReturnType<typeof createAnnotationAnchor>;
    range: Range | null;
    problem: 'none' | 'empty' | 'invalid' | 'too-long';
  }

  interface EditorState {
    editingId: string | null;
    anchor: AnnotationAnchor | null;
  }

  interface AnnotationI18n {
    annotations: string;
    annotationsOpen: string;
    annotationsEmpty: string;
    annotationsEmptyHint: string;
    annotationHighlight: string;
    annotationAddNote: string;
    annotationEdit: string;
    annotationJump: string;
    annotationQuote: string;
    annotationNote: string;
    annotationNotePlaceholder: string;
    annotationSave: string;
    annotationSaved: string;
    annotationDelete: string;
    annotationDeleted: string;
    annotationCancel: string;
    annotationClose: string;
    annotationStorageUnavailable: string;
    annotationInvalidSelection: string;
    annotationTooLong: string;
    annotationOverlap: string;
    annotationSaveFailed: string;
    annotationDeleteFailed: string;
    annotationMoved: string;
    annotationConflict: string;
    annotationJumped: string;
    annotationToolbar: string;
    annotationExcerpts: string;
  }

  function parseRecord(value: string | undefined): Record<string, unknown> {
    try {
      return JSON.parse(value ?? '{}') as Record<string, unknown>;
    } catch {
      return {};
    }
  }

  function readLang(root: HTMLElement): AnnotationLang {
    return root.dataset.lang === 'en' ? 'en' : 'zh';
  }

  function readI18n(root: HTMLElement, lang: Lang): AnnotationI18n {
    const parsed = parseRecord(root.dataset.i18n);
    const fallback = UI[lang] as Record<string, string>;
    const keys: (keyof AnnotationI18n)[] = [
      'annotations',
      'annotationsOpen',
      'annotationsEmpty',
      'annotationsEmptyHint',
      'annotationHighlight',
      'annotationAddNote',
      'annotationEdit',
      'annotationJump',
      'annotationQuote',
      'annotationNote',
      'annotationNotePlaceholder',
      'annotationSave',
      'annotationSaved',
      'annotationDelete',
      'annotationDeleted',
      'annotationCancel',
      'annotationClose',
      'annotationStorageUnavailable',
      'annotationInvalidSelection',
      'annotationTooLong',
      'annotationOverlap',
      'annotationSaveFailed',
      'annotationDeleteFailed',
      'annotationMoved',
      'annotationConflict',
      'annotationJumped',
      'annotationToolbar',
      'annotationExcerpts',
    ];
    const i18n = {} as AnnotationI18n;
    for (const key of keys) {
      i18n[key] =
        typeof parsed[key] === 'string'
          ? (parsed[key] as string)
          : (fallback[key] ?? String(key));
    }
    return i18n;
  }

  function getStorage(): Storage | null {
    try {
      return window.localStorage;
    } catch {
      return null;
    }
  }

  function isEligibleText(node: Text): boolean {
    const parent = node.parentElement;
    if (!parent || !node.data.length || parent.closest(EXCLUDED)) return false;
    if (parent.closest('[hidden], [aria-hidden="true"]')) return false;
    const checkVisibility = (
      parent as HTMLElement & { checkVisibility?: () => boolean }
    ).checkVisibility;
    if (typeof checkVisibility === 'function' && !checkVisibility.call(parent)) {
      return false;
    }
    const style = getComputedStyle(parent);
    return style.display !== 'none' && style.visibility !== 'hidden';
  }

  function textSegments(body: HTMLElement): { segments: TextSegment[]; text: string } {
    const walker: TreeWalker = document.createTreeWalker(body, NodeFilter.SHOW_TEXT);
    const segments: TextSegment[] = [];
    let text = '';

    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
      if (node.nodeType !== Node.TEXT_NODE || !isEligibleText(node as Text)) continue;
      const value = (node as Text).data;
      const start = text.length;
      text += value;
      segments.push({
        node: node as Text,
        start,
        end: start + value.length,
      });
    }

    return { segments, text };
  }

  function boundaryOffset(
    body: HTMLElement,
    segments: TextSegment[],
    container: Node,
    offset: number,
    edge: 'start' | 'end',
  ): number | null {
    if (container !== body && !body.contains(container)) return null;

    if (container.nodeType === Node.TEXT_NODE) {
      const node = container as Text;
      const segment = segments.find((candidate) => candidate.node === node);
      if (!segment || offset < 0 || offset > node.data.length) return null;
      return segment.start + offset;
    }

    if (container.nodeType !== Node.ELEMENT_NODE) return null;
    const element = container as Element;
    if (element !== body && element.closest(EXCLUDED)) return null;
    if (
      element !== body &&
      element.closest('[hidden], [aria-hidden="true"]')
    ) {
      return null;
    }

    const point = document.createRange();
    try {
      point.setStart(container, offset);
    } catch {
      return null;
    }
    point.collapse(true);

    if (edge === 'start') {
      for (const segment of segments) {
        const segmentRange = document.createRange();
        segmentRange.selectNodeContents(segment.node);
        if (point.compareBoundaryPoints(Range.START_TO_START, segmentRange) <= 0) {
          return segment.start;
        }
      }
      return null;
    }

    let end: number | null = null;
    for (const segment of segments) {
      const segmentRange = document.createRange();
      segmentRange.selectNodeContents(segment.node);
      if (point.compareBoundaryPoints(Range.END_TO_END, segmentRange) >= 0) {
        end = segment.end;
      } else {
        break;
      }
    }
    return end;
  }

  function selectionSnapshot(body: HTMLElement): SelectionSnapshot {
    const selection = window.getSelection();
    if (!selection || selection.rangeCount === 0 || selection.isCollapsed) {
      return { anchor: null, range: null, problem: 'empty' };
    }

    const range = selection.getRangeAt(0);
    const { segments, text } = textSegments(body);
    const start = boundaryOffset(
      body,
      segments,
      range.startContainer,
      range.startOffset,
      'start',
    );
    const end = boundaryOffset(
      body,
      segments,
      range.endContainer,
      range.endOffset,
      'end',
    );
    if (start === null || end === null || end <= start) {
      return { anchor: null, range, problem: 'invalid' };
    }

    const anchor = createAnnotationAnchor(text, start, end);
    if (!anchor) {
      return {
        anchor: null,
        range,
        problem: end - start > ANNOTATION_QUOTE_LIMIT ? 'too-long' : 'invalid',
      };
    }

    return { anchor, range, problem: 'none' };
  }

  function unwrapHighlights(body: HTMLElement): void {
    body.querySelectorAll<HTMLElement>('mark[data-annotation-id]').forEach((mark) => {
      mark.replaceWith(document.createTextNode(mark.textContent ?? ''));
    });
    body.normalize();
  }

  let controller: AbortController | null = null;
  let surfaceCleanup: (() => void) | null = null;

  function closeDialogs(root: HTMLElement): void {
    root.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((dialog) => {
      dialog.close();
    });
  }

  function init(): void {
    controller?.abort();
    surfaceCleanup?.();
    surfaceCleanup = null;
    controller = new AbortController();
    const { signal } = controller;

    const root = document.querySelector<HTMLElement>('[data-article-annotations]');
    if (!root) return;

    const lang = readLang(root);
    const postId = root.dataset.postId;
    if (!postId) return;
    const article = root.closest('article');
    const body = article?.querySelector<HTMLElement>('.post-body');
    if (!body) return;

    const i18n = readI18n(root, lang);
    const entry = root.querySelector<HTMLButtonElement>('[data-annotations-open]');
    const count = root.querySelector<HTMLElement>('[data-annotations-count]');
    const drawer = root.querySelector<HTMLDialogElement>('[data-annotations-dialog]');
    const drawerClose = root.querySelector<HTMLButtonElement>('[data-annotations-close]');
    const empty = root.querySelector<HTMLElement>('[data-annotations-empty]');
    const list = root.querySelector<HTMLOListElement>('[data-annotations-list]');
    const toolbar = root.querySelector<HTMLElement>('[data-annotation-toolbar]');
    const highlightButton =
      root.querySelector<HTMLButtonElement>('[data-annotation-highlight]');
    const noteButton = root.querySelector<HTMLButtonElement>('[data-annotation-note]');
    const status = root.querySelector<HTMLElement>('[data-annotation-status]');
    const editor = root.querySelector<HTMLDialogElement>('[data-annotation-editor]');
    const form = root.querySelector<HTMLFormElement>('[data-annotation-form]');
    const editorTitle =
      root.querySelector<HTMLElement>('[data-annotation-editor-title]');
    const editorQuote = root.querySelector<HTMLElement>('[data-annotation-quote]');
    const noteInput =
      root.querySelector<HTMLTextAreaElement>('[data-annotation-note-input]');
    const deleteButton =
      root.querySelector<HTMLButtonElement>('[data-annotation-delete]');
    const cancelButtons = [
      ...root.querySelectorAll<HTMLButtonElement>('[data-annotation-cancel]'),
    ];
    if (
      !entry ||
      !count ||
      !drawer ||
      !drawerClose ||
      !empty ||
      !list ||
      !toolbar ||
      !highlightButton ||
      !noteButton ||
      !status ||
      !editor ||
      !form ||
      !editorTitle ||
      !editorQuote ||
      !noteInput ||
      !deleteButton ||
      cancelButtons.length === 0
    ) {
      return;
    }

    const storage = getStorage();
    if (!storage) return;

    let store: AnnotationStore = readAnnotationStore(storage);
    let selectedRecords: AnnotationRecord[] = [];
    let selectionFrame = 0;
    let pendingSnapshot: SelectionSnapshot | null = null;
    let editorReturnFocus: HTMLElement | null = null;
    let editorState: EditorState = { editingId: null, anchor: null };

    const setStatus = (message: string): void => {
      status.textContent = message;
    };

    const formatCount = (value: number): string =>
      i18n.annotationExcerpts.replace('{count}', String(value));

    const formatDate = (value: number): string =>
      Number.isNaN(new Date(value).getTime())
        ? ''
        : new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          }).format(new Date(value));

    const hideToolbar = (): void => {
      toolbar.hidden = true;
      toolbar.style.removeProperty('left');
      toolbar.style.removeProperty('top');
    };

    const findMark = (id: string): HTMLElement | null =>
      [...body.querySelectorAll<HTMLElement>('mark[data-annotation-id]')].find(
        (mark) => mark.dataset.annotationId === id,
      ) ?? null;

    const findCardButton = (
      action: 'edit' | 'delete',
      id: string,
    ): HTMLButtonElement | null =>
      [...list.querySelectorAll<HTMLButtonElement>(`[data-annotation-${action}]`)].find(
        (button) =>
          action === 'edit'
            ? button.dataset.annotationEdit === id
            : button.dataset.annotationDelete === id,
      ) ?? null;

    const canReceiveFocus = (element: HTMLElement | null): boolean =>
      Boolean(
        element?.isConnected &&
          !element.hidden &&
          getComputedStyle(element).visibility !== 'hidden' &&
          element.getClientRects().length > 0,
      );

    const focusElement = (element: HTMLElement | null): boolean => {
      if (!canReceiveFocus(element)) return false;
      element.focus({ preventScroll: true });
      return true;
    };

    const renderHighlights = (): void => {
      unwrapHighlights(body);
      const { segments, text } = textSegments(body);
      selectedRecords = selectAnnotationsForPost(store, lang, postId);
      const resolved = resolveAnnotationAnchors(selectedRecords, text);
      const jobs: {
        record: AnnotationRecord;
        segment: TextSegment;
        localStart: number;
        localEnd: number;
        first: boolean;
        last: boolean;
      }[] = [];

      for (const item of resolved) {
        if (item.start === null || item.end === null) continue;
        const parts = segments.filter(
          (segment) => segment.end > item.start! && segment.start < item.end!,
        );
        parts.forEach((segment, index) => {
          jobs.push({
            record: item.record,
            segment,
            localStart: Math.max(0, item.start! - segment.start),
            localEnd: Math.min(segment.node.data.length, item.end! - segment.start),
            first: index === 0,
            last: index === parts.length - 1,
          });
        });
      }

      jobs.sort(
        (a, b) =>
          b.segment.start + b.localStart - (a.segment.start + a.localStart),
      );

      for (const job of jobs) {
        const { node } = job.segment;
        if (!node.isConnected || job.localEnd <= job.localStart) continue;
        const range = document.createRange();
        range.setStart(node, Math.min(job.localStart, node.data.length));
        range.setEnd(node, Math.min(job.localEnd, node.data.length));
        const mark = document.createElement('mark');
        mark.dataset.annotationId = job.record.id;
        mark.setAttribute('data-annotation-first', String(job.first));
        mark.setAttribute('data-annotation-last', String(job.last));
        mark.title = job.record.quote;
        if (job.first) mark.tabIndex = 0;
        range.surroundContents(mark);
      }

      count.textContent = String(selectedRecords.length);
      entry.title = formatCount(selectedRecords.length);
    };

    const navigateToAnnotation = (id: string): void => {
      drawer.close();
      requestAnimationFrame(() => {
        const mark = findMark(id);
        if (!mark) return;
        mark.scrollIntoView({ block: 'center' });
        mark.focus({ preventScroll: true });
        mark.classList.add('annotation-pulse');
        const removePulse = (): void => mark.classList.remove('annotation-pulse');
        mark.addEventListener('animationend', removePulse, { once: true });
        window.setTimeout(removePulse, 700);
        setStatus(i18n.annotationJumped);
      });
    };

    const makeCardButton = (
      label: string,
      action: 'jump' | 'edit' | 'delete',
      id: string,
    ): HTMLButtonElement => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'annotation-card__action';
      button.textContent = label;
      if (action === 'jump') {
        button.addEventListener('click', () => navigateToAnnotation(id));
      } else if (action === 'edit') {
        button.dataset.annotationEdit = id;
      } else {
        button.dataset.annotationDelete = id;
      }
      return button;
    };

    const renderDrawer = (): void => {
      const { text } = textSegments(body);
      const resolved = resolveAnnotationAnchors(selectedRecords, text);
      list.replaceChildren();
      empty.hidden = resolved.length > 0;
      count.textContent = String(selectedRecords.length);
      entry.title = formatCount(selectedRecords.length);

      for (const item of resolved) {
        const { record } = item;
        const listItem = document.createElement('li');
        listItem.className = 'annotation-card';
        listItem.dataset.annotationId = record.id;

        const quote = document.createElement('blockquote');
        quote.className = 'annotation-card__quote';
        quote.textContent = record.quote;
        quote.setAttribute('aria-label', i18n.annotationQuote);
        listItem.append(quote);

        if (record.note) {
          const note = document.createElement('p');
          note.className = 'annotation-card__note';
          note.textContent = record.note;
          listItem.append(note);
        }

        const meta = document.createElement('div');
        meta.className = 'annotation-card__meta';
        const date = document.createElement('time');
        const dateValue = new Date(record.updatedAt);
        if (!Number.isNaN(dateValue.getTime())) {
          date.dateTime = dateValue.toISOString();
          date.textContent = formatDate(record.updatedAt);
        }
        meta.append(date);

        if (item.status === 'missing' || item.status === 'conflict') {
          const resolution = document.createElement('span');
          resolution.className = 'annotation-card__status';
          resolution.textContent =
            item.status === 'missing'
              ? i18n.annotationMoved
              : i18n.annotationConflict;
          meta.append(resolution);
        }
        listItem.append(meta);

        const actions = document.createElement('div');
        actions.className = 'annotation-card__actions';
        if (item.start !== null && item.end !== null) {
          actions.append(makeCardButton(i18n.annotationJump, 'jump', record.id));
        }
        if (item.status !== 'conflict') {
          actions.append(makeCardButton(i18n.annotationEdit, 'edit', record.id));
        }
        actions.append(makeCardButton(i18n.annotationDelete, 'delete', record.id));
        listItem.append(actions);
        list.append(listItem);
      }
    };

    const commitStore = (
      nextStore: AnnotationStore,
      successMessage: string,
      failureMessage: string,
    ): boolean => {
      if (!writeAnnotationStore(storage, nextStore)) {
        setStatus(failureMessage);
        return false;
      }
      store = nextStore;
      renderHighlights();
      renderDrawer();
      setStatus(successMessage);
      return true;
    };

    const closeEditor = (focusMarkId: string | null = null): void => {
      const editingId = editorState.editingId;
      const invoker = editorReturnFocus;
      editor.close();
      editorState = { editingId: null, anchor: null };
      editorReturnFocus = null;
      noteButton.setAttribute('aria-expanded', 'false');

      requestAnimationFrame(() => {
        const candidates = [
          focusMarkId ? findMark(focusMarkId) : null,
          editingId ? findCardButton('edit', editingId) : null,
          drawer.open ? drawerClose : null,
          invoker,
          drawer.open ? null : entry,
        ];
        for (const candidate of candidates) {
          if (focusElement(candidate)) return;
        }
        body.tabIndex = -1;
        body.focus({ preventScroll: true });
      });
    };

    const openEditor = (
      state: EditorState,
      record: AnnotationRecord | null,
      invoker: HTMLElement | null,
    ): void => {
      editorReturnFocus = invoker;
      editorState = state;
      editorTitle.textContent = record ? i18n.annotationEdit : i18n.annotationAddNote;
      editorQuote.textContent = record?.quote ?? state.anchor?.quote ?? '';
      editorQuote.setAttribute('aria-label', i18n.annotationQuote);
      noteInput.value = record?.note ?? '';
      deleteButton.hidden = !record;
      noteButton.setAttribute('aria-expanded', 'true');
      if (!editor.open) editor.showModal();
      requestAnimationFrame(() => {
        noteInput.focus({ preventScroll: true });
        noteInput.setSelectionRange(noteInput.value.length, noteInput.value.length);
      });
    };

    const openRecordEditor = (
      record: AnnotationRecord,
      invoker: HTMLElement | null,
    ): void => {
      openEditor({ editingId: record.id, anchor: null }, record, invoker);
    };

    const overlapsExisting = (anchor: AnnotationAnchor): boolean => {
      const { text } = textSegments(body);
      return resolveAnnotationAnchors(selectedRecords, text).some(
        (item) =>
          item.start !== null &&
          item.end !== null &&
          anchor.start < item.end &&
          anchor.end > item.start,
      );
    };

    const currentPendingAnchor = (): AnnotationAnchor | null => {
      const snapshot = selectionSnapshot(body);
      const { text } = textSegments(body);
      const valid = (anchor: AnnotationAnchor | null): anchor is AnnotationAnchor =>
        Boolean(
          anchor &&
            anchor.start >= 0 &&
            anchor.end > anchor.start &&
            anchor.end <= text.length &&
            text.slice(anchor.start, anchor.end) === anchor.quote,
        );

      if (valid(snapshot.anchor)) {
        pendingSnapshot = snapshot;
        return snapshot.anchor;
      }
      if (valid(pendingSnapshot?.anchor ?? null)) {
        return pendingSnapshot!.anchor;
      }
      setStatus(
        snapshot.problem === 'too-long'
          ? i18n.annotationTooLong
          : i18n.annotationInvalidSelection,
      );
      return null;
    };

    const saveNewAnnotation = (anchor: AnnotationAnchor, note: string): string | null => {
      if (overlapsExisting(anchor)) {
        setStatus(i18n.annotationOverlap);
        return null;
      }

      let record: AnnotationRecord;
      try {
        record = createAnnotationRecord(
          {
            lang,
            postId,
            quote: anchor.quote,
            note,
            start: anchor.start,
            end: anchor.end,
            prefix: anchor.prefix,
            suffix: anchor.suffix,
          },
          Date.now(),
        );
      } catch {
        setStatus(i18n.annotationSaveFailed);
        return null;
      }

      const nextStore = upsertAnnotation(store, record);
      if (!commitStore(nextStore, i18n.annotationSaved, i18n.annotationSaveFailed)) {
        return null;
      }
      return record.id;
    };

    const quickHighlight = (): void => {
      const anchor = currentPendingAnchor();
      if (!anchor) return;
      const id = saveNewAnnotation(anchor, '');
      if (!id) return;
      pendingSnapshot = null;
      hideToolbar();
      window.getSelection()?.removeAllRanges();
    };

    const openNewNoteEditor = (): void => {
      const anchor = currentPendingAnchor();
      if (!anchor) return;
      hideToolbar();
      openEditor({ editingId: null, anchor }, null, noteButton);
    };

    const saveEditor = (): void => {
      const note = noteInput.value.trim();
      if (editorState.editingId) {
        const nextStore = updateAnnotationNote(
          store,
          editorState.editingId,
          note,
          Date.now(),
        );
        const updated = nextStore.records.find(
          (record) => record.id === editorState.editingId,
        );
        if (!updated || updated.note !== note) {
          setStatus(i18n.annotationSaveFailed);
          return;
        }
        if (
          !commitStore(nextStore, i18n.annotationSaved, i18n.annotationSaveFailed)
        ) {
          return;
        }
        closeEditor(updated.id);
        return;
      }

      const anchor = editorState.anchor;
      if (!anchor) {
        setStatus(i18n.annotationInvalidSelection);
        return;
      }
      const id = saveNewAnnotation(anchor, note);
      if (!id) return;
      pendingSnapshot = null;
      window.getSelection()?.removeAllRanges();
      closeEditor(id);
    };

    const deleteEditingAnnotation = (): void => {
      const id = editorState.editingId;
      if (!id) return;
      const nextStore = removeAnnotation(store, id);
      if (
        !commitStore(nextStore, i18n.annotationDeleted, i18n.annotationDeleteFailed)
      ) {
        return;
      }
      closeEditor();
    };

    const placeToolbar = (range: Range): void => {
      toolbar.hidden = false;
      const rect = range.getBoundingClientRect();
      const toolbarRect = toolbar.getBoundingClientRect();
      const margin = 8;

      let top = rect.top - toolbarRect.height - margin;
      if (top < margin) top = rect.bottom + margin;
      top = Math.max(
        margin,
        Math.min(top, window.innerHeight - toolbarRect.height - margin),
      );

      const centered = rect.left + rect.width / 2 - toolbarRect.width / 2;
      const left = Math.max(
        margin,
        Math.min(centered, window.innerWidth - toolbarRect.width - margin),
      );

      toolbar.style.left = `${Math.round(left)}px`;
      toolbar.style.top = `${Math.round(top)}px`;
    };

    const inspectSelection = (): void => {
      const snapshot = selectionSnapshot(body);
      if (!snapshot.anchor || !snapshot.range || snapshot.problem !== 'none') {
        pendingSnapshot = null;
        hideToolbar();
        return;
      }
      pendingSnapshot = snapshot;
      placeToolbar(snapshot.range);
    };

    const scheduleSelection = (): void => {
      if (selectionFrame) cancelAnimationFrame(selectionFrame);
      selectionFrame = requestAnimationFrame(() => {
        selectionFrame = 0;
        inspectSelection();
      });
    };

    const setExpanded = (expanded: boolean): void => {
      entry.setAttribute('aria-expanded', String(expanded));
    };

    renderHighlights();
    renderDrawer();
    noteButton.setAttribute('aria-expanded', 'false');
    entry.hidden = false;

    entry.addEventListener(
      'click',
      () => {
        renderDrawer();
        setExpanded(true);
        if (!drawer.open) drawer.showModal();
      },
      { signal },
    );
    drawerClose.addEventListener('click', () => drawer.close(), { signal });
    drawer.addEventListener('close', () => setExpanded(false), { signal });
    drawer.addEventListener(
      'cancel',
      () => {
        setExpanded(false);
        setStatus('');
      },
      { signal },
    );

    list.addEventListener(
      'click',
      (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const edit = target.closest<HTMLButtonElement>('[data-annotation-edit]');
        if (edit?.dataset.annotationEdit) {
          const record = store.records.find(
            (candidate) => candidate.id === edit.dataset.annotationEdit,
          );
          if (record) openRecordEditor(record, edit);
          return;
        }
        const remove = target.closest<HTMLButtonElement>('[data-annotation-delete]');
        if (remove?.dataset.annotationDelete) {
          const id = remove.dataset.annotationDelete;
          const nextStore = removeAnnotation(store, id);
          if (
            !commitStore(
              nextStore,
              i18n.annotationDeleted,
              i18n.annotationDeleteFailed,
            )
          ) {
            return;
          }
          requestAnimationFrame(() => {
            const next = findCardButton('delete', id) ?? drawerClose;
            focusElement(next);
          });
        }
      },
      { signal },
    );

    form.addEventListener(
      'submit',
      (event) => {
        event.preventDefault();
        saveEditor();
      },
      { signal },
    );
    cancelButtons.forEach((button) => {
      button.addEventListener('click', () => closeEditor(), { signal });
    });
    deleteButton.addEventListener('click', deleteEditingAnnotation, { signal });
    editor.addEventListener(
      'cancel',
      () => {
        editorState = { editingId: null, anchor: null };
        editorReturnFocus = null;
        noteButton.setAttribute('aria-expanded', 'false');
      },
      { signal },
    );
    editor.addEventListener(
      'close',
      () => {
        editorState = { editingId: null, anchor: null };
        noteButton.setAttribute('aria-expanded', 'false');
      },
      { signal },
    );

    noteButton.addEventListener('click', openNewNoteEditor, { signal });
    highlightButton.addEventListener('click', quickHighlight, { signal });
    toolbar.addEventListener('pointerdown', (event) => event.preventDefault(), { signal });
    document.addEventListener('selectionchange', scheduleSelection, { signal });
    document.addEventListener('pointerup', scheduleSelection, { signal });
    document.addEventListener('keyup', scheduleSelection, { signal });
    document.addEventListener('touchend', scheduleSelection, { signal });
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape') return;
        pendingSnapshot = null;
        hideToolbar();
      },
      { signal },
    );
    window.addEventListener('scroll', hideToolbar, { signal, passive: true });

    body.addEventListener(
      'click',
      (event) => {
        const selection = window.getSelection();
        if (selection && !selection.isCollapsed) return;
        const target = event.target;
        if (!(target instanceof Element)) return;
        const mark = target.closest<HTMLElement>('mark[data-annotation-id]');
        const id = mark?.dataset.annotationId;
        if (!id) return;
        const record = store.records.find((candidate) => candidate.id === id);
        if (record) openRecordEditor(record, mark);
      },
      { signal },
    );
    body.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const target = event.target;
        if (!(target instanceof Element)) return;
        const mark = target.closest<HTMLElement>('mark[data-annotation-id]');
        const id = mark?.dataset.annotationId;
        if (!id) return;
        const record = store.records.find((candidate) => candidate.id === id);
        if (!record) return;
        event.preventDefault();
        openRecordEditor(record, mark);
      },
      { signal },
    );

    window.addEventListener(
      'storage',
      (event) => {
        if (event.key !== ANNOTATION_STORAGE_KEY) return;
        store = readAnnotationStore(storage);
        renderHighlights();
        renderDrawer();
      },
      { signal },
    );

    surfaceCleanup = () => {
      if (selectionFrame) cancelAnimationFrame(selectionFrame);
      selectionFrame = 0;
      pendingSnapshot = null;
      editorState = { editingId: null, anchor: null };
      editorReturnFocus = null;
      closeDialogs(root);
      hideToolbar();
      unwrapHighlights(body);
      setStatus('');
      noteButton.setAttribute('aria-expanded', 'false');
      window.getSelection()?.removeAllRanges();
    };

    document.addEventListener('astro:before-swap', () => {
        closeDialogs(root);
        setExpanded(false);
        surfaceCleanup?.();
        surfaceCleanup = null;
        controller?.abort();
      }, { signal });
  }

  const start = (): void => {
    if (document.querySelector('[data-article-annotations]')) init();
  };

  document.addEventListener('astro:page-load', start);
  if (document.readyState !== 'loading') start();
</script>

